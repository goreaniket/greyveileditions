  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "Chapter 5",
  "title": "CHAPTER 5 — WHEN TWO REALITIES START COEXISTING",
  "shortTitle": "WHEN TWO REALITIES START COEXISTING",
  "sourceRange": [
