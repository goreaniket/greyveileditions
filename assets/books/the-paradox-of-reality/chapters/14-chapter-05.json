  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kabhi kabhi ek moment hota hai jo bilkul normal lagta hai."
        }
      ],
      "sourceParagraph": 718
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi intensity."
        }
      ],
      "sourceParagraph": 719
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi external disturbance."
        }
      ],
      "sourceParagraph": 720
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi obvious reason."
        }
      ],
      "sourceParagraph": 721
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin us normal moment ke andar ek invisible breakdown chal raha hota hai."
        }
      ],
      "sourceParagraph": 722
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh breakdown sudden nahi hota."
        }
      ],
      "sourceParagraph": 723
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh continuous split hota hai."
        }
      ],
      "sourceParagraph": 724
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek reality hoti hai:"
        }
      ],
      "sourceParagraph": 725
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " jo physically ho raha hai"
        }
      ],
      "sourceParagraph": 726
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ek reality hoti hai:"
        }
      ],
      "sourceParagraph": 727
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " jo internally construct ho rahi hoti hai"
        }
      ],
      "sourceParagraph": 728
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur shuruaat mein yeh dono same lagte hain."
        }
      ],
      "sourceParagraph": 729
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki mind unko ek single experience mein compress kar deta hai."
        }
      ],
      "sourceParagraph": 730
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin yeh compression stable nahi hota."
        }
      ],
      "sourceParagraph": 731
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Dheere dheere ek gap appear hota hai."
        }
      ],
      "sourceParagraph": 732
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek subtle difference."
        }
      ],
      "sourceParagraph": 733
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek almost unnoticeable mismatch."
        }
      ],
      "sourceParagraph": 734
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ab ek insaan ke liye ek situation neutral hoti hai."
        }
      ],
      "sourceParagraph": 735
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur dusre insaan ke liye wahi situation loaded hoti hai."
        }
      ],
      "sourceParagraph": 736
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur interesting baat yeh hai:"
        }
      ],
      "sourceParagraph": 737
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "dono apni reality ko “correct” feel karte hain."
        }
      ],
      "sourceParagraph": 738
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh difference opinion nahi hota."
        }
      ],
      "sourceParagraph": 739
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh internal construction architecture ka difference hota hai."
        }
      ],
      "sourceParagraph": 740
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum ek hi moment mein sirf ek reality experience nahi karte."
        }
      ],
      "sourceParagraph": 741
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum multiple realities ko stack karte ho:"
        }
      ],
      "sourceParagraph": 742
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "factual layer (what is happening)"
        }
      ],
      "sourceParagraph": 743
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "emotional layer (what it feels like)"
        }
      ],
      "sourceParagraph": 744
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "interpretite layer (what it means)"
        }
      ],
      "sourceParagraph": 745
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memory layer (what it reminds of)"
        }
      ],
      "sourceParagraph": 746
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "predictive layer (what might happen next)"
        }
      ],
      "sourceParagraph": 747
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh sab ek hi second ke andar active hota hai."
        }
      ],
      "sourceParagraph": 748
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur tumhe lagta hai tum “present” mein ho."
        }
      ],
      "sourceParagraph": 749
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin present already fragmented hota hai."
        }
      ],
      "sourceParagraph": 750
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Koi insaan normal tone mein bol raha hai."
        }
      ],
      "sourceParagraph": 751
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Surface reality: words neutral hain"
        }
      ],
      "sourceParagraph": 752
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But instantly:"
        }
      ],
      "sourceParagraph": 753
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory layer: “pehle bhi aisa tone use hua tha”"
        }
      ],
      "sourceParagraph": 754
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Emotion layer: “yeh safe nahi lag raha”"
        }
      ],
      "sourceParagraph": 755
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Prediction layer: “ab kuch negative hoga”"
        }
      ],
      "sourceParagraph": 756
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Interpretation layer: “intent hidden hai”"
        }
      ],
      "sourceParagraph": 757
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ek single sentence…"
        }
      ],
      "sourceParagraph": 758
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "multiple realities generate kar deta hai."
        }
      ],
      "sourceParagraph": 759
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahi pe reality stable nahi rehti."
        }
      ],
      "sourceParagraph": 760
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Woh branch ho jaati hai."
        }
      ],
      "sourceParagraph": 761
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum notice karte ho ki:"
        }
      ],
      "sourceParagraph": 762
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "log ek hi world mein exist nahi kar rahe…"
        }
      ],
      "sourceParagraph": 763
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "log apni-apni internal worlds mein exist kar rahe hain."
        }
      ],
      "sourceParagraph": 764
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur har world internally consistent hota hai."
        }
      ],
      "sourceParagraph": 765
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye har insaan ko apni reality “true” lagti hai."
        }
      ],
      "sourceParagraph": 766
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh truth conflict create karta hai."
        }
      ],
      "sourceParagraph": 767
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Conflict is not because someone is wrong."
        }
      ],
      "sourceParagraph": 768
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Conflict is because:"
        }
      ],
      "sourceParagraph": 769
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " koi single shared reality exist hi nahi karti in pure form"
        }
      ],
      "sourceParagraph": 770
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf overlap zones hoti hain."
        }
      ],
      "sourceParagraph": 771
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Temporary agreement."
        }
      ],
      "sourceParagraph": 772
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Context-based alignment."
        }
      ],
      "sourceParagraph": 773
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab woh alignment toot jaati hai…"
        }
      ],
      "sourceParagraph": 774
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh clash hota hai."
        }
      ],
      "sourceParagraph": 775
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind naturally ek tendency rakhta hai:"
        }
      ],
      "sourceParagraph": 776
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek reality ko “real” label karne ki"
        }
      ],
      "sourceParagraph": 777
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur baaki ko “distorted” label karne ki"
        }
      ],
      "sourceParagraph": 778
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin yeh labeling bhi constructed hoti hai."
        }
      ],
      "sourceParagraph": 779
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory + conditioning + fear + past reinforcement."
        }
      ],
      "sourceParagraph": 780
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jab tum zyada observe karte ho…"
        }
      ],
      "sourceParagraph": 781
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange realization aata hai:"
        }
      ],
      "sourceParagraph": 782
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " tum ek world nahi dekh rahe ho"
        }
      ],
      "sourceParagraph": 783
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " tum multiple possible worlds ke overlap ko experience kar rahe ho"
        }
      ],
      "sourceParagraph": 784
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur har overlap moment pe reality thodi si shift hoti rehti hai."
        }
      ],
      "sourceParagraph": 785
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without announcement."
        }
      ],
      "sourceParagraph": 786
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without permission."
        }
      ],
      "sourceParagraph": 787
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without pause."
        }
      ],
      "sourceParagraph": 788
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab yeh fully visible ho jaata hai…"
        }
      ],
      "sourceParagraph": 789
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek silent clarity aati hai:"
        }
      ],
      "sourceParagraph": 790
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“jo main reality samajh raha tha… woh ek fixed thing nahi, balki continuously branching experience hai”"
        }
      ],
      "sourceParagraph": 791
    }
