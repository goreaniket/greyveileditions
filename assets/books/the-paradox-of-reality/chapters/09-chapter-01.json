    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na koi event."
        }
      ],
      "sourceParagraph": 345
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na koi shock."
        }
      ],
      "sourceParagraph": 346
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na koi emotional trigger."
        }
      ],
      "sourceParagraph": 347
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas tum hotey ho… aur duniya chal rahi hoti hai."
        }
      ],
      "sourceParagraph": 348
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin phir ek strange sa gap feel hota hai."
        }
      ],
      "sourceParagraph": 349
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not visible."
        }
      ],
      "sourceParagraph": 350
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not explainable."
        }
      ],
      "sourceParagraph": 351
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas ek subtle mismatch."
        }
      ],
      "sourceParagraph": 352
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise jo tum dekh rahe ho…"
        }
      ],
      "sourceParagraph": 353
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur jo tum “samajh rahe ho ki tum dekh rahe ho”…"
        }
      ],
      "sourceParagraph": 354
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "dono perfectly align nahi kar rahe."
        }
      ],
      "sourceParagraph": 355
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Shuruaat mein yeh bahut small hota hai."
        }
      ],
      "sourceParagraph": 356
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Almost ignoreable."
        }
      ],
      "sourceParagraph": 357
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum kisi cheez ko dekhte ho:"
        }
      ],
      "sourceParagraph": 358
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek room, ek face, ek situation, ek silence."
        }
      ],
      "sourceParagraph": 359
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur sab normal lagta hai."
        }
      ],
      "sourceParagraph": 360
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin us normal ke andar ek layer hoti hai:"
        }
      ],
      "sourceParagraph": 361
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "yeh normal kyu lag raha hai?”"
        }
      ],
      "sourceParagraph": 362
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahi pe first fracture start hota hai."
        }
      ],
      "sourceParagraph": 363
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Reality mein nahi…"
        }
      ],
      "sourceParagraph": 364
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "perception mein."
        }
      ],
      "sourceParagraph": 365
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum notice karte ho ki:"
        }
      ],
      "sourceParagraph": 366
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo cheez “real” lag rahi hai…"
        }
      ],
      "sourceParagraph": 367
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "woh actually directly present nahi lag rahi…"
        }
      ],
      "sourceParagraph": 368
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "woh processed lag rahi hai."
        }
      ],
      "sourceParagraph": 369
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise mind ke andar se pass ho kar aa rahi ho."
        }
      ],
      "sourceParagraph": 370
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ek aur uncomfortable realization aata hai:"
        }
      ],
      "sourceParagraph": 371
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " tum reality nahi dekh rahe ho"
        }
      ],
      "sourceParagraph": 372
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " tum reality ka interpretation dekh rahe ho"
        }
      ],
      "sourceParagraph": 373
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ab yeh thought nahi lagta."
        }
      ],
      "sourceParagraph": 374
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh ek observation jaisa feel hota hai."
        }
      ],
      "sourceParagraph": 375
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum kisi cheez ko dekhte ho…"
        }
      ],
      "sourceParagraph": 376
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur saath hi yeh bhi feel hota hai:"
        }
      ],
      "sourceParagraph": 377
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“yeh main dekh raha hoon… ya yeh mere through create ho raha hai?”"
        }
      ],
      "sourceParagraph": 378
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us second mein clarity nahi aati…"
        }
      ],
      "sourceParagraph": 379
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "us second mein stability thodi si hil jaati hai."
        }
      ],
      "sourceParagraph": 380
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki pehli baar yeh suspicion aata hai:"
        }
      ],
      "sourceParagraph": 381
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "shayad reality ek fixed thing nahi hai "
        }
      ],
      "sourceParagraph": 382
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "shayad reality ek continuously processed experience hai"
        }
      ],
      "sourceParagraph": 383
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur agar reality processed hai…"
        }
      ],
      "sourceParagraph": 384
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh question shift hota hai:"
        }
      ],
      "sourceParagraph": 385
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“phir original kya hai?”"
        }
      ],
      "sourceParagraph": 386
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin yeh question bhi jaldi dissolve ho jaata hai…"
        }
      ],
      "sourceParagraph": 387
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki “original” bhi ek idea ban jaata hai."
        }
      ],
      "sourceParagraph": 388
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahan pe mind ek loop mein chala jaata hai:"
        }
      ],
      "sourceParagraph": 389
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "real kya hai?"
        }
      ],
      "sourceParagraph": 390
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo dikh raha hai ya jo ho raha hai?"
        }
      ],
      "sourceParagraph": 391
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ya jo samjha ja raha hai?"
        }
      ],
      "sourceParagraph": 392
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur koi answer stable nahi rehta."
        }
      ],
      "sourceParagraph": 393
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur sabse dangerous part yeh hai:"
        }
      ],
      "sourceParagraph": 394
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " reality change nahi hoti"
        }
      ],
      "sourceParagraph": 395
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " sirf uska “certainty layer” weaken hota hai"
        }
      ],
      "sourceParagraph": 396
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "World wahi hota hai."
        }
      ],
      "sourceParagraph": 397
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Log wahi hote hain."
