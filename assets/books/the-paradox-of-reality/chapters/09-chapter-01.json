    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Situation wahi hoti hai."
        }
      ],
      "sourceParagraph": 399
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ek invisible shift ho chuka hota hai:"
        }
      ],
      "sourceParagraph": 400
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“this is real” ab automatic nahi lagta"
        }
      ],
      "sourceParagraph": 401
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh doubt nahi hai."
        }
      ],
      "sourceParagraph": 402
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh confusion nahi hai."
