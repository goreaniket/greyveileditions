  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kabhi kabhi life bahar se bilkul normal chal rahi hoti hai…"
        }
      ],
      "sourceParagraph": 267
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par andar ek strange sa silence grow kar raha hota hai."
        }
