      "sourceParagraph": 268
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na kuch collapse hota hai."
        }
      ],
      "sourceParagraph": 269
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na kuch dramatically change hota hai."
        }
      ],
      "sourceParagraph": 270
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi clear reason hota hai."
        }
      ],
      "sourceParagraph": 271
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas ek subtle shift hota hai…"
        }
      ],
      "sourceParagraph": 272
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo pehle notice bhi nahi hota."
        }
      ],
      "sourceParagraph": 273
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum dekhte ho same duniya ko."
