  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "This book is dedicated to those who cannot stop observing themselves."
        }
      ],
      "sourceParagraph": 53
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To those who think more than they speak."
        }
      ],
      "sourceParagraph": 54
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To those who notice patterns others ignore."
        }
      ],
      "sourceParagraph": 55
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To those who feel the weight of their own thoughts but continue to analyze them anyway."
        }
      ],
      "sourceParagraph": 56
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To the minds that question even their own understanding."
        }
      ],
      "sourceParagraph": 57
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And to the silent internal dialogue that never fully stops."
        }
      ],
      "sourceParagraph": 58
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And also to the part of every human being"
        }
      ],
      "sourceParagraph": 59
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "that once experienced life without analysis —"
        }
      ],
      "sourceParagraph": 60
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "and still remembers what that felt like, even faintly."
        }
      ],
      "sourceParagraph": 61
    }
  ],
  "index": 4,
  "file": "chapters/04-dedication.json"
}
