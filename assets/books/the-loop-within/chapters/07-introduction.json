      "sourceParagraph": 191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh shayad wo tumhe us tarah na mile jaisa tum expect kar rahe ho. "
        }
      ],
      "sourceParagraph": 192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki ye book tumhare emotions ko soothe karne ke liye nahi bani. "
        }
      ],
      "sourceParagraph": 193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye book isliye bani hai ki tum samajh sako ki emotions bante kaise hain. "
        }
      ],
      "sourceParagraph": 194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Zyada tar log sochte hain ki unke saath jo hota hai, wahi unka dard hai. "
        }
      ],
      "sourceParagraph": 195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Par asal mein jo unhe control karta hai… "
        }
