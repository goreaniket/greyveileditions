    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But it makes everything slightly transparent."
        }
      ],
      "sourceParagraph": 2241
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Less absolute."
        }
      ],
      "sourceParagraph": 2242
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Less personal."
        }
      ],
      "sourceParagraph": 2243
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Less final."
        }
      ],
      "sourceParagraph": 2244
    },
    {
      "type": "paragraph",
