  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tu abhi jo padh raha hai na…"
        }
      ],
      "sourceParagraph": 160
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo ek book nahi hai."
        }
      ],
      "sourceParagraph": 161
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye ek aisa mirror hai jisme tu khud ko tab dekhega jab tu dekhna band kar chuka hoga."
        }
      ],
      "sourceParagraph": 162
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur problem ye nahi hai ki tu sochta hai."
        }
      ],
      "sourceParagraph": 163
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Problem ye hai ki tu sochna band nahi kar pata."
        }
      ],
      "sourceParagraph": 164
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kabhi notice kiya hai?"
        }
      ],
      "sourceParagraph": 165
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek thought aata hai…"
        }
      ],
      "sourceParagraph": 166
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur uske baad tu us thought ke andar chala jata hai."
        }
      ],
      "sourceParagraph": 167
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Phir tu us thought ko observe nahi karta…"
        }
      ],
      "sourceParagraph": 168
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tu us thought ko live karta hai."
        }
      ],
      "sourceParagraph": 169
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us moment pe ek cheez quietly disappear ho jati hai:"
        }
      ],
      "sourceParagraph": 170
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " “Tu jo "
        },
        {
          "text": "observe"
        },
        {
          "text": " kar raha tha, wo bhi tu hi tha.”"
        }
      ],
      "sourceParagraph": 171,
      "role": "quote-line"
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yahin se start hota hai distortion."
        }
      ],
      "sourceParagraph": 172
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi crash."
        }
      ],
      "sourceParagraph": 173
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi breakdown."
        }
      ],
      "sourceParagraph": 174
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas ek subtle shift…"
        }
      ],
      "sourceParagraph": 175
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jahan reality wahi hoti hai,"
        }
      ],
      "sourceParagraph": 176
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par usko dekhne wala change ho jata hai."
        }
      ],
      "sourceParagraph": 177
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur tujhe pata bhi nahi chalta."
        }
      ],
      "sourceParagraph": 178
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sabse dangerous illusion kya hai pata hai?"
        }
      ],
      "sourceParagraph": 179
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ki tu sochta hai tu real time me jee raha hai."
        }
      ],
      "sourceParagraph": 180
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Par majority time tu live nahi hota…"
        }
      ],
      "sourceParagraph": 181
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tu interpretation delay me hota hai."
        }
      ],
      "sourceParagraph": 182
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har cheez pe reaction,"
        }
      ],
      "sourceParagraph": 183
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "har moment pe meaning,"
        }
      ],
      "sourceParagraph": 184
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "har silence pe assumption."
        }
      ],
      "sourceParagraph": 185
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur dheere dheere ek nayi reality ban jati hai:"
        }
      ],
      "sourceParagraph": 186
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " Ek aisi reality jo cheezon se nahi…"
        }
      ],
      "sourceParagraph": 187
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tere analysis se chalti hai."
        }
      ],
      "sourceParagraph": 188
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ek point aata hai…"
        }
      ],
      "sourceParagraph": 189
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jab silence bhi message lagne lagta hai."
        }
      ],
      "sourceParagraph": 190
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Random thought bhi signal ban jata hai."
        }
      ],
      "sourceParagraph": 191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Normal cheez bhi “deep” lagne lagti hai."
        }
      ],
      "sourceParagraph": 192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur tu sochta hai — “main aware ho raha hu”"
        }
      ],
      "sourceParagraph": 193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Par sach ye hota hai:"
        }
      ],
      "sourceParagraph": 194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tu aware nahi hota…"
        }
      ],
      "sourceParagraph": 195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tu over-interpret kar raha hota hai."
        }
      ],
      "sourceParagraph": 196
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye book tujhe kuch naya nahi sikha rahi."
        }
      ],
      "sourceParagraph": 197
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ek cheez todne ki koshish kar rahi hai:"
        }
      ],
      "sourceParagraph": 198
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " Tera automatic meaning-making system."
        }
      ],
      "sourceParagraph": 199
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki jab tak har experience ko meaning milega…"
        }
      ],
      "sourceParagraph": 200
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tab tak experience kabhi raw nahi hoga."
        }
      ],
      "sourceParagraph": 201
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek simple sa truth:"
        }
      ],
      "sourceParagraph": 202
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tu apni life ko direct nahi jeeta."
        }
      ],
      "sourceParagraph": 203
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tu uska continuous narration jeeta hai."
        }
      ],
      "sourceParagraph": 204
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur narration itna fast hota hai…"
        }
      ],
      "sourceParagraph": 205
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki tu kabhi notice hi nahi karta ki original moment kab chala gaya."
        }
      ],
      "sourceParagraph": 206
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ab sabse uncomfortable part:"
        }
      ],
      "sourceParagraph": 207
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jo tu “main” samajhta hai na…"
        }
      ],
      "sourceParagraph": 208
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo ek fixed entity nahi hai."
        }
      ],
      "sourceParagraph": 209
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo ek ongoing explanation hai."
        }
      ],
      "sourceParagraph": 210
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har second update hota hua…"
        }
      ],
      "sourceParagraph": 211
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "har memory se edit hota hua…"
        }
      ],
      "sourceParagraph": 212
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "har fear se reshape hota hua."
        }
      ],
      "sourceParagraph": 213
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye is book ka naam “The Last Shift” hai."
        }
      ],
      "sourceParagraph": 214
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki ye kisi nayi identity banane ki baat nahi karta."
        }
      ],
      "sourceParagraph": 215
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye us moment ki baat karta hai jahan tu realize karta hai:"
        }
      ],
      "sourceParagraph": 216
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " shift ho chuka tha…"
        }
      ],
      "sourceParagraph": 217
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par tu us shift ko thoughts ke through samajhne ki koshish kar raha tha."
        }
      ],
      "sourceParagraph": 218
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab tu yahan tak aayega na…"
        }
      ],
      "sourceParagraph": 219
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To do possibilities hongi:"
        }
