      "sourceParagraph": 222
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur agar tu ruk gaya…"
        }
      ],
      "sourceParagraph": 223
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "To tujhe ek strange sa gap feel hoga:"
        }
      ],
      "sourceParagraph": 224
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " Thought aur awareness ke beech ka gap."
        }
      ],
      "sourceParagraph": 225
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us gap me…"
