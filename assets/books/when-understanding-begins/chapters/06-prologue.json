{
  "id": "prologue",
  "kind": "prologue",
  "label": "Prologue",
  "title": "Before You Decide You Already Know Yourself",
  "shortTitle": "Prologue",
  "file": "chapters/06-prologue.json",
  "index": 6,
  "sourceRange": [
