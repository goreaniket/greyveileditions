          "text": "desires"
        }
      ],
      "sourceParagraph": 478
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur phir ek invisible process un sab ko ek centre ke around organise kar deta hai."
        }
      ],
      "sourceParagraph": 479
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Us centre ka naam hota hai:"
        }
      ],
      "sourceParagraph": 480
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "\"Me\""
        }
      ],
      "sourceParagraph": 481
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Identity ka sabse interesting part ye hai..."
        }
      ],
      "sourceParagraph": 482
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki wo kabhi directly experience nahi hoti."
        }
      ],
      "sourceParagraph": 483
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum sadness experience kar sakte ho."
