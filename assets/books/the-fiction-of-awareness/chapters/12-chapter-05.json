      "sourceParagraph": 527
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur identity us “next” ke around re-assemble hoti rehti hai."
        }
      ],
      "sourceParagraph": 528
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "So life ek journey nahi hoti…"
        }
      ],
      "sourceParagraph": 529
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "life ek continuous postponement ban jati hai."
        }
      ],
      "sourceParagraph": 530
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye postponement hi identity ko alive rakhta hai."
        }
      ],
      "sourceParagraph": 531
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar koi instant completeness feel ho jaye…"
        }
      ],
      "sourceParagraph": 532
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh becoming collapse ho jata hai."
        }
      ],
      "sourceParagraph": 533
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur mind us collapse ko tolerate nahi karta."
        }
      ],
      "sourceParagraph": 534
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye wo turant ek new lack create kar deta hai."
        }
      ],
      "sourceParagraph": 535
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Becoming ka sabse deep fiction ye hai:"
