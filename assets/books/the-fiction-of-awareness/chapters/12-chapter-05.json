      "sourceParagraph": 495
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par hamesha present hota hai."
        }
      ],
      "sourceParagraph": 496
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye idea simple lagta hai:"
        }
      ],
      "sourceParagraph": 497
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main better banunga.”"
        }
      ],
      "sourceParagraph": 498
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main heal ho jaunga.”"
        }
      ],
      "sourceParagraph": 499
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main complete ho jaunga.”"
        }
      ],
      "sourceParagraph": 500
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar deeply dekha jaye…"
        }
      ],
      "sourceParagraph": 501
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh “becoming” kabhi end point nahi hota."
        }
      ],
      "sourceParagraph": 502
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye ek continuous projection system hota hai."
        }
      ],
      "sourceParagraph": 503
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har present moment ke saath mind ek parallel image banata hai:"
        }
      ],
      "sourceParagraph": 504
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“jo main hona chahiye tha.”"
        }
      ],
      "sourceParagraph": 505
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“jo main ho sakta hoon.”"
        }
      ],
      "sourceParagraph": 506
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“jo main ban raha hoon.”"
        }
      ],
      "sourceParagraph": 507
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ye image kabhi present reality mein exist nahi karti."
        }
      ],
      "sourceParagraph": 508
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf imagination mein exist karti hai."
        }
      ],
      "sourceParagraph": 509
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur interesting baat ye hai:"
        }
      ],
      "sourceParagraph": 510
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum present ko live nahi karte…"
        }
      ],
      "sourceParagraph": 511
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum present ko compare karte rehte hain."
        }
      ],
      "sourceParagraph": 512
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Future ke against."
        }
      ],
      "sourceParagraph": 513
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is comparison se ek gap create hota hai:"
        }
      ],
      "sourceParagraph": 514
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“main abhi kaafi nahi hoon.”"
        }
      ],
      "sourceParagraph": 515
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi gap ko hum growth samajh lete hain."
        }
      ],
      "sourceParagraph": 516
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin growth aksar reality change nahi karti…"
        }
      ],
      "sourceParagraph": 517
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo sirf dissatisfaction ko organize karti hai."
        }
      ],
      "sourceParagraph": 518
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Becoming ka illusion ye hai:"
        }
      ],
      "sourceParagraph": 519
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Ek final version exist karta hai jahan main finally okay ho jaunga.”"
        }
      ],
      "sourceParagraph": 520
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin jaise hi wo version imagine hota hai…"
        }
      ],
      "sourceParagraph": 521
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "mind ek aur version create kar deta hai."
        }
      ],
      "sourceParagraph": 522
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye becoming kabhi complete nahi hota."
        }
      ],
      "sourceParagraph": 523
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki wo completion pe based hi nahi hai."
        }
      ],
      "sourceParagraph": 524
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo deferral pe based hai."
        }
      ],
      "sourceParagraph": 525
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har achievement ke baad…"
        }
      ],
      "sourceParagraph": 526
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek naya “next” create ho jata hai."
        }
