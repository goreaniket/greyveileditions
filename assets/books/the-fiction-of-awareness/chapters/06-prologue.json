  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Shuruaat hamesha ek story se nahi hoti…"
        }
      ],
      "sourceParagraph": 88
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kabhi-kabhi shuruaat ek assumption se hoti hai."
        }
      ],
      "sourceParagraph": 89
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahan bhi wahi hua."
        }
      ],
      "sourceParagraph": 90
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek assumption silently already present thi:"
        }
      ],
      "sourceParagraph": 91
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main yahan hoon.”"
        }
      ],
      "sourceParagraph": 92
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is assumption ko kabhi prove nahi kiya gaya…"
        }
      ],
      "sourceParagraph": 93
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki isko prove karne ki zarurat kabhi feel hi nahi hui."
        }
      ],
      "sourceParagraph": 94
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye bas felt as obvious."
        }
      ],
      "sourceParagraph": 95
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi “obviousness” ke andar pura human experience build ho gaya."
        }
      ],
      "sourceParagraph": 96
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Thoughts aaye…"
        }
      ],
      "sourceParagraph": 97
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur unko “main soch raha hoon” bana diya gaya."
        }
      ],
      "sourceParagraph": 98
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Feelings aaye…"
        }
      ],
      "sourceParagraph": 99
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur unko “main feel kar raha hoon” bana diya gaya."
        }
      ],
      "sourceParagraph": 100
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memories aayi…"
        }
      ],
      "sourceParagraph": 101
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur unko “mera past” bana diya gaya."
        }
      ],
      "sourceParagraph": 102
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur bina kisi notice ke…"
        }
      ],
      "sourceParagraph": 103
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek invisible center create ho gaya:"
        }
      ],
      "sourceParagraph": 104
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“I”"
        }
      ],
      "sourceParagraph": 105
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin interesting baat ye hai:"
        }
      ],
      "sourceParagraph": 106
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye center kabhi directly dekha nahi gaya."
        }
      ],
      "sourceParagraph": 107
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf assume kiya gaya."
        }
      ],
      "sourceParagraph": 108
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab koi cheez continuously assume ki jaye…"
        }
      ],
      "sourceParagraph": 109
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo reality jaisi lagne lagti hai."
        }
      ],
      "sourceParagraph": 110
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The Human Fiction yahin se start nahi hoti…"
        }
      ],
      "sourceParagraph": 111
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye yahin se notice hoti hai."
        }
      ],
      "sourceParagraph": 112
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ab jo aage aane wala hai…"
        }
      ],
      "sourceParagraph": 113
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo koi new truth nahi hai."
        }
      ],
      "sourceParagraph": 114
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf ek structure ko dheere-dheere visible hote hue dekhna hai…"
        }
      ],
      "sourceParagraph": 115
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo hamesha already chal raha tha."
        }
      ],
      "sourceParagraph": 116
    }
