{
  "id": "the-fiction-of-self",
  "kind": "introduction",
  "sourceKind": "introduction",
  "label": "Introduction",
  "title": "THE FICTION OF SELF",
  "shortTitle": "THE FICTION OF SELF",
  "sourceRange": [
    117,
    188
  ],
  "headerSourceParagraphs": {
    "number": 117,
    "title": 118
  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek cheez hum sab silently assume karte hain…"
        }
      ],
      "sourceParagraph": 119
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "without even questioning it:"
        }
      ],
      "sourceParagraph": 120
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main yeh life jee raha hoon.”"
        }
      ],
      "sourceParagraph": 121
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar is sentence ko thoda aur slowly dekha jaye…"
        }
      ],
      "sourceParagraph": 122
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange question nikalta hai:"
        }
      ],
      "sourceParagraph": 123
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye “main” actually hai kya?"
        }
      ],
      "sourceParagraph": 124
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kya ye koi fixed cheez hai jo body ke andar baithi hai…"
        }
      ],
      "sourceParagraph": 125
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur life ko experience kar rahi hai?"
        }
      ],
      "sourceParagraph": 126
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ya phir ye sirf ek ongoing feeling hai…"
        }
      ],
      "sourceParagraph": 127
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo har moment recreate hoti rehti hai?"
        }
      ],
      "sourceParagraph": 128
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The Human Fiction — Book I isi question ko explore nahi karta…"
        }
      ],
      "sourceParagraph": 129
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye is assumption ko dheere-dheere dissolve hota hua dikhata hai."
        }
      ],
      "sourceParagraph": 130
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum “self” ko ek solid entity maan lete hain:"
        }
      ],
      "sourceParagraph": 131
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo sochti hai"
        }
      ],
      "sourceParagraph": 132
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo feel karti hai"
        }
      ],
      "sourceParagraph": 133
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo decisions leti hai"
        }
      ],
      "sourceParagraph": 134
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo memories rakhti hai"
        }
      ],
      "sourceParagraph": 135
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo future plan karti hai"
        }
      ],
      "sourceParagraph": 136
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar direct experience ko dekha jaye…"
        }
      ],
      "sourceParagraph": 137
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh koi ek fixed center kabhi directly milta hi nahi."
        }
      ],
      "sourceParagraph": 138
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf moments hote hain."
        }
      ],
      "sourceParagraph": 139
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Thoughts hote hain."
        }
      ],
      "sourceParagraph": 140
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Feelings hote hain."
        }
      ],
      "sourceParagraph": 141
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memories hoti hain."
        }
      ],
      "sourceParagraph": 142
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur in sab ke beech ek invisible story chal rahi hoti hai:"
        }
      ],
      "sourceParagraph": 143
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“ye sab mera hai”"
        }
      ],
      "sourceParagraph": 144
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe fiction start hoti hai."
        }
      ],
      "sourceParagraph": 145
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye book koi belief change karne ke liye nahi hai."
        }
      ],
      "sourceParagraph": 146
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na ye kehta hai ki “self exists nahi karta”"
        }
      ],
      "sourceParagraph": 147
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na ye kehta hai ki “self ek illusion hai” in a philosophical slogan sense."
        }
      ],
      "sourceParagraph": 148
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ek cheez dikhata hai:"
        }
      ],
      "sourceParagraph": 149
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kaise ek “center” continuously banaya ja raha hai…"
        }
      ],
      "sourceParagraph": 150
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "without ever being found."
        }
      ],
      "sourceParagraph": 151
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har chapter ek layer remove karta hai…"
        }
      ],
      "sourceParagraph": 152
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "lekin koi violence nahi hoti."
        }
      ],
      "sourceParagraph": 153
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Koi force nahi hota."
        }
      ],
      "sourceParagraph": 154
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf clarity hoti hai."
        }
      ],
      "sourceParagraph": 155
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise-jaise book aage badhti hai:"
        }
      ],
      "sourceParagraph": 156
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "thought ka narrator dissolve hota hai"
        }
      ],
      "sourceParagraph": 157
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memory ka ownership structure visible hota hai"
        }
      ],
      "sourceParagraph": 158
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "inner voice ka illusion breakdown hota hai"
        }
      ],
      "sourceParagraph": 159
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "meaning ek interpretation system lagne lagta hai"
        }
      ],
      "sourceParagraph": 160
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "becoming ek endless projection ban jata hai"
        }
      ],
      "sourceParagraph": 161
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur even “witness” bhi identity ban jata hai"
        }
      ],
      "sourceParagraph": 162
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur finally…"
        }
      ],
      "sourceParagraph": 163
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo bachta hai…"
        }
      ],
      "sourceParagraph": 164
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo koi “answer” nahi hota."
        }
      ],
      "sourceParagraph": 165
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf ek strange simplicity hoti hai:"
        }
      ],
      "sourceParagraph": 166
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience ho raha hai…"
        }
      ],
      "sourceParagraph": 167
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "without asking “kiske liye”."
        }
      ],
      "sourceParagraph": 168
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is book ka aim tumhe kuch naya dena nahi hai."
        }
      ],
      "sourceParagraph": 169
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Iska aim hai:"
        }
      ],
      "sourceParagraph": 170
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo already chal raha hai usko dekhne ki clarity dena."
        }
      ],
      "sourceParagraph": 171
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki jab koi structure clearly dekh liya jata hai…"
        }
      ],
      "sourceParagraph": 172
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo apni authority quietly lose kar deta hai."
        }
      ],
      "sourceParagraph": 173
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur tab ek uncomfortable but honest realization aata hai:"
        }
      ],
      "sourceParagraph": 174
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo “main” lagta tha…"
        }
      ],
      "sourceParagraph": 175
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo kabhi ek cheez tha hi nahi."
        }
      ],
      "sourceParagraph": 176
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf ek continuously written story thi…"
        }
      ],
      "sourceParagraph": 177
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo itni fast likhi ja rahi thi ki lagta tha wo already complete hai."
        }
      ],
      "sourceParagraph": 178
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The Human Fiction yahi puchta hai:"
        }
      ],
      "sourceParagraph": 179
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "agar story hi self hai…"
        }
      ],
      "sourceParagraph": 180
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh writer kahan hai?"
        }
      ],
      "sourceParagraph": 181
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur phir ye question bhi dissolve ho jata hai…"
        }
      ],
      "sourceParagraph": 182
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki writer ki zarurat bhi story ke andar hi thi."
        }
      ],
      "sourceParagraph": 183
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is book ka end kisi conclusion pe nahi hota."
        }
      ],
      "sourceParagraph": 184
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye ek shift pe hota hai."
        }
      ],
      "sourceParagraph": 185
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek silent shift…"
        }
      ],
      "sourceParagraph": 186
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "from believing a center exists…"
        }
      ],
      "sourceParagraph": 187
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "to noticing that center was never located in the first place."
        }
      ],
      "sourceParagraph": 188
    }
  ],
