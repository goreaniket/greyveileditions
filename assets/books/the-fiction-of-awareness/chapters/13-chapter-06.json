{
  "id": "chapter-06",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "Chapter 6",
  "title": "The Collapse of the Self-Story",
  "shortTitle": "The Collapse of the Self-Story",
  "sourceRange": [
    553,
