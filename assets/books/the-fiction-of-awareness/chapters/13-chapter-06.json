  ],
  "headerSourceParagraphs": {
    "number": 553,
    "title": 554
  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar pichle chapters mein self ek continuous story ki tarah dikh raha tha…"
        }
      ],
      "sourceParagraph": 555
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ab ek aur layer samajh aati hai:"
        }
      ],
      "sourceParagraph": 556
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye story utni solid nahi hai jitni lagti hai."
        }
      ],
      "sourceParagraph": 557
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Self ka pura structure ek narrative stitching par based tha:"
        }
      ],
      "sourceParagraph": 558
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memory se past"
        }
      ],
      "sourceParagraph": 559
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "thought se present"
        }
      ],
      "sourceParagraph": 560
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "imagination se future"
        }
      ],
      "sourceParagraph": 561
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur “I” se continuity"
        }
      ],
      "sourceParagraph": 562
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin jab in sab ko ek saath dekha jaye…"
        }
      ],
      "sourceParagraph": 563
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange gap appear hota hai."
        }
      ],
      "sourceParagraph": 564
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye “self-story” actually kabhi directly exist nahi karti."
        }
      ],
      "sourceParagraph": 565
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf moments ke beech ka interpretation hota hai."
        }
      ],
      "sourceParagraph": 566
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har moment apne aap complete hota hai."
        }
      ],
      "sourceParagraph": 567
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Uske andar koi “unfinished identity” nahi hoti."
        }
      ],
      "sourceParagraph": 568
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin mind un moments ko connect karta rehta hai…"
        }
      ],
      "sourceParagraph": 569
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur un connections ko ek single flow bana deta hai."
        }
      ],
      "sourceParagraph": 570
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye flow strong ho jata hai…"
        }
      ],
      "sourceParagraph": 571
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh lagta hai jaise ek consistent “someone” exist kar raha ho."
        }
      ],
      "sourceParagraph": 572
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But agar attention thoda aur direct ho jaye…"
        }
      ],
      "sourceParagraph": 573
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ye flow tootne lagta hai."
        }
      ],
      "sourceParagraph": 574
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na past fully present hota hai."
        }
      ],
      "sourceParagraph": 575
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na future actually accessible hota hai."
        }
      ],
      "sourceParagraph": 576
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na present koi narrative carry karta hai."
        }
      ],
      "sourceParagraph": 577
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf isolated appearances hoti hain."
        }
      ],
      "sourceParagraph": 578
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur in appearances ke beech jo “bridge” hota hai…"
        }
      ],
      "sourceParagraph": 579
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo actually real nahi hota."
        }
      ],
      "sourceParagraph": 580
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo constructed continuity hoti hai."
        }
      ],
      "sourceParagraph": 581
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Self ka poora structure isi bridge pe khada hota hai."
        }
      ],
      "sourceParagraph": 582
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye jab ye bridge visible ho jata hai…"
        }
      ],
      "sourceParagraph": 583
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh self ka idea unstable lagne lagta hai."
        }
      ],
      "sourceParagraph": 584
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin interesting baat ye hai:"
        }
      ],
      "sourceParagraph": 585
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kuch “collapse” nahi hota physically."
        }
      ],
      "sourceParagraph": 586
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf ek belief weaken hota hai."
        }
      ],
      "sourceParagraph": 587
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Belief that:"
        }
      ],
      "sourceParagraph": 588
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“there is someone living this life”"
        }
      ],
      "sourceParagraph": 589
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye belief thoda loose hota hai…"
        }
      ],
      "sourceParagraph": 590
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh experience change nahi hota…"
        }
      ],
      "sourceParagraph": 591
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf interpretation change hoti hai."
        }
      ],
      "sourceParagraph": 592
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Same thoughts."
        }
      ],
      "sourceParagraph": 593
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Same sensations."
        }
      ],
      "sourceParagraph": 594
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Same world."
        }
      ],
      "sourceParagraph": 595
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But ownership ka weight kam ho jata hai."
        }
      ],
      "sourceParagraph": 596
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi state mein ek strange clarity appear hoti hai:"
        }
      ],
      "sourceParagraph": 597
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "cheezon ko chalane ke liye kisi “center” ki zarurat nahi hoti."
        }
      ],
      "sourceParagraph": 598
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Self-story collapse ka matlab disappearance nahi hai."
        }
      ],
      "sourceParagraph": 599
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Matlab hai:"
        }
      ],
      "sourceParagraph": 600
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "story ko literal truth na maanna."
        }
      ],
      "sourceParagraph": 601
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab story literal truth nahi lagti…"
        }
      ],
      "sourceParagraph": 602
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo sirf narrative ban jati hai."
        }
      ],
      "sourceParagraph": 603
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur narrative ke andar rehkar bhi…"
        }
      ],
      "sourceParagraph": 604
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek quiet gap hamesha available hota hai."
        }
      ],
      "sourceParagraph": 605
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jahan koi “I” actively present nahi hota."
        }
      ],
      "sourceParagraph": 606
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas happening hoti hai."
        }
      ],
      "sourceParagraph": 607
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without owner."
        }
      ],
      "sourceParagraph": 608
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without center."
        }
      ],
      "sourceParagraph": 609
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without claim."
        }
      ],
      "sourceParagraph": 610
    }
  ],
