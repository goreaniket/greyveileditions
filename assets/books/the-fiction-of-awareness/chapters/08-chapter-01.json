  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum ek aisi cheez ke saath jeete hain jisko hum kabhi directly observe nahi karte…"
        }
      ],
      "sourceParagraph": 191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "phir bhi uske bina hum kisi experience ko imagine nahi kar sakte."
        }
      ],
      "sourceParagraph": 192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo cheez hai — “I”."
        }
      ],
      "sourceParagraph": 193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye “I” kabhi experience ke andar ek object ki tarah present nahi hota."
        }
      ],
      "sourceParagraph": 194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar tum dhyaan se dekho, toh na thoughts ke andar koi “I” milta hai…"
        }
      ],
      "sourceParagraph": 195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na emotions ke andar…"
        }
      ],
      "sourceParagraph": 196
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na memories ke andar…"
        }
      ],
      "sourceParagraph": 197
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Phir bhi har experience ke saath ek invisible center feel hota hai."
        }
      ],
      "sourceParagraph": 198
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise har cheez kisi ek point se belong kar rahi ho."
        }
      ],
      "sourceParagraph": 199
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin wo point kabhi dikhai nahi deta."
        }
      ],
      "sourceParagraph": 200
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf assume kiya jata hai."
        }
      ],
      "sourceParagraph": 201
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin se fiction start hoti hai."
        }
      ],
      "sourceParagraph": 202
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har moment jo experience hota hai, uske saath mind ek silent operation karta hai:"
        }
      ],
      "sourceParagraph": 203
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo experience ko label karta hai."
        }
      ],
      "sourceParagraph": 204
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek thought aata hai…"
        }
      ],
      "sourceParagraph": 205
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur turant uske upar ownership attach ho jati hai:"
        }
      ],
      "sourceParagraph": 206
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“main soch raha hoon.”"
        }
      ],
      "sourceParagraph": 207
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar sirf thought ko dekha jaye…"
        }
      ],
      "sourceParagraph": 208
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo bas ek movement hai."
        }
      ],
      "sourceParagraph": 209
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Us movement ke andar koi signature nahi hota."
        }
      ],
      "sourceParagraph": 210
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na “mine”, na “not mine”."
        }
      ],
      "sourceParagraph": 211
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Phir ek memory aati hai…"
        }
      ],
      "sourceParagraph": 212
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur wo memory ek personal timeline bana deti hai:"
        }
      ],
      "sourceParagraph": 213
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“ye mere saath hua tha.”"
        }
      ],
      "sourceParagraph": 214
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But memory khud kabhi ye claim nahi karti."
        }
      ],
      "sourceParagraph": 215
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Claim mind add karta hai."
        }
      ],
      "sourceParagraph": 216
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Same with emotion."
        }
      ],
      "sourceParagraph": 217
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek feeling arise hoti hai…"
        }
      ],
      "sourceParagraph": 218
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "and immediately it becomes:"
        }
      ],
      "sourceParagraph": 219
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“ye mujhe lag raha hai.”"
        }
      ],
      "sourceParagraph": 220
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin feeling sirf energy + sensation hai."
        }
      ],
      "sourceParagraph": 221
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ownership later interpretation hai."
        }
      ],
      "sourceParagraph": 222
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yahan ek subtle pattern emerge hota hai:"
        }
      ],
      "sourceParagraph": 223
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Experience → Label → Ownership → Identity reinforcement"
        }
      ],
      "sourceParagraph": 224
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye cycle itni fast hoti hai ki hum kabhi pause karke dekh hi nahi paate ki ownership add ho rahi hai."
        }
      ],
      "sourceParagraph": 225
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum usko reality maan lete hain."
        }
      ],
      "sourceParagraph": 226
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye “I” koi single entity nahi lagta…"
        }
      ],
      "sourceParagraph": 227
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo ek continuous stitching process lagta hai."
        }
      ],
      "sourceParagraph": 228
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har moment ke fragments ko jod ke ek smooth illusion banaya jata hai."
        }
      ],
      "sourceParagraph": 229
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye stitching visible nahi hoti."
        }
      ],
      "sourceParagraph": 230
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki wo gap mein hoti hai."
        }
      ],
      "sourceParagraph": 231
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur mind gaps ko ignore karta hai."
        }
      ],
      "sourceParagraph": 232
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jo cheez gap mein hoti hai…"
        }
      ],
      "sourceParagraph": 233
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo sabse zyada real feel hoti hai."
        }
      ],
      "sourceParagraph": 234
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye “I” kabhi questioned nahi hota."
        }
      ],
      "sourceParagraph": 235
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki wo experience ke beech mein nahi hai…"
        }
      ],
      "sourceParagraph": 236
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo experience ke upar overlay ki tarah chal raha hota hai."
        }
      ],
      "sourceParagraph": 237
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar tum direct attention se dekho…"
        }
      ],
      "sourceParagraph": 238
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange thing samajh aati hai:"
        }
