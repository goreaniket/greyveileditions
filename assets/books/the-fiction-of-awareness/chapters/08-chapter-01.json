      "sourceParagraph": 239
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“I” never appears before experience."
        }
      ],
      "sourceParagraph": 240
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It always appears after experience."
