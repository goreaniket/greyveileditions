  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar Chapter 1 ne ye show kiya ki “I” koi fixed cheez nahi hai…"
        }
      ],
      "sourceParagraph": 283
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh Chapter 2 ye batata hai ki memory us illusion ko kaise alive rakhti hai."
        }
      ],
      "sourceParagraph": 284
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum generally memory ko ek storage system samajhte hain…"
        }
      ],
      "sourceParagraph": 285
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jaise brain mein past store ho raha ho."
        }
      ],
      "sourceParagraph": 286
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin lived experience mein memory aisa behave nahi karti."
        }
      ],
      "sourceParagraph": 287
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory past ko “retrieve” nahi karti…"
        }
      ],
      "sourceParagraph": 288
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo present moment mein past ka reconstruction karti hai."
        }
      ],
      "sourceParagraph": 289
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab bhi koi memory aati hai…"
        }
      ],
      "sourceParagraph": 290
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo kabhi “pure past” nahi hoti."
        }
      ],
      "sourceParagraph": 291
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo hamesha ek present interpretation hoti hai."
        }
      ],
      "sourceParagraph": 292
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur usi instant pe mind ek cheez add karta hai:"
        }
      ],
      "sourceParagraph": 293
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“ye mere saath hua tha”"
        }
      ],
      "sourceParagraph": 294
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin interesting baat ye hai:"
        }
      ],
      "sourceParagraph": 295
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memory khud kabhi ownership claim nahi karti."
        }
      ],
      "sourceParagraph": 296
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ownership baad mein attach hota hai."
        }
      ],
      "sourceParagraph": 297
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Automatically."
        }
      ],
      "sourceParagraph": 298
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory ke andar sirf fragments hote hain:"
        }
      ],
      "sourceParagraph": 299
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "image"
        }
      ],
      "sourceParagraph": 300
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "feeling"
        }
      ],
      "sourceParagraph": 301
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sensation"
        }
      ],
      "sourceParagraph": 302
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "scene"
        }
      ],
      "sourceParagraph": 303
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas."
        }
      ],
      "sourceParagraph": 304
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin mind un fragments ko jod deta hai…"
        }
      ],
      "sourceParagraph": 305
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur ek story bana deta hai:"
        }
      ],
      "sourceParagraph": 306
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“ye mera past hai”"
        }
      ],
      "sourceParagraph": 307
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahi se “personal history” start hoti hai."
        }
      ],
      "sourceParagraph": 308
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar deeply dekha jaye…"
        }
      ],
      "sourceParagraph": 309
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh koi “past self” directly available nahi hota."
        }
      ],
      "sourceParagraph": 310
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf reconstructed moments hote hain."
        }
      ],
      "sourceParagraph": 311
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory ka real function truth preserve karna nahi hai…"
        }
      ],
      "sourceParagraph": 312
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "balke continuity preserve karna hai."
        }
      ],
      "sourceParagraph": 313
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki agar continuity toot jaye…"
        }
      ],
      "sourceParagraph": 314
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh “I” ka idea weak pad jata hai."
        }
      ],
      "sourceParagraph": 315
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye mind memory ko ek chain ki tarah connect karta hai:"
        }
      ],
      "sourceParagraph": 316
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Present → Past → Identity"
        }
      ],
      "sourceParagraph": 317
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur is chain ke beech ek assumption silently add hota hai:"
        }
      ],
      "sourceParagraph": 318
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“There was someone experiencing it.”"
        }
      ],
      "sourceParagraph": 319
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin wo “someone” memory ke andar kabhi visible nahi hota."
        }
      ],
      "sourceParagraph": 320
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo hamesha inference hota hai."
        }
      ],
      "sourceParagraph": 321
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe illusion deepen hota hai."
        }
      ],
      "sourceParagraph": 322
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki ab “self” sirf present experience se nahi banta…"
        }
      ],
      "sourceParagraph": 323
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo past reconstruction se bhi banta hai."
        }
      ],
      "sourceParagraph": 324
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "So self ek double-layer system ban jata hai:"
        }
      ],
      "sourceParagraph": 325
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present experience"
        }
      ],
      "sourceParagraph": 326
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "reconstructed past"
        }
      ],
      "sourceParagraph": 327
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur dono milke ek continuous identity create karte hain."
        }
      ],
      "sourceParagraph": 328
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ye continuity real continuity nahi hoti."
        }
      ],
      "sourceParagraph": 329
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye stitched continuity hoti hai."
        }
      ],
      "sourceParagraph": 330
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur stitching itni smooth hoti hai…"
        }
      ],
      "sourceParagraph": 331
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki mind usko truth maan leta hai."
        }
      ],
      "sourceParagraph": 332
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But truth simple hai:"
        }
      ],
      "sourceParagraph": 333
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory proof nahi hai ki “you existed”"
        }
      ],
      "sourceParagraph": 334
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory sirf ye prove karti hai ki narration continuously chal raha hai."
        }
      ],
      "sourceParagraph": 335
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur narration hi identity ban jata hai."
        }
      ],
      "sourceParagraph": 336
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye “my past” actually past nahi hota…"
        }
      ],
      "sourceParagraph": 337
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo present ka reconstructed story hota hai."
        }
      ],
      "sourceParagraph": 338
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye story kabhi stop nahi hoti…"
        }
      ],
      "sourceParagraph": 339
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki har moment naye reconstruction ka base ban jata hai."
        }
      ],
      "sourceParagraph": 340
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye cycle visible hota hai…"
        }
      ],
      "sourceParagraph": 341
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange realization aata hai:"
        }
      ],
      "sourceParagraph": 342
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo “me” lagta hai…"
        }
      ],
      "sourceParagraph": 343
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo actually memory + interpretation ka ongoing loop hai."
        }
      ],
      "sourceParagraph": 344
    }
  ],
