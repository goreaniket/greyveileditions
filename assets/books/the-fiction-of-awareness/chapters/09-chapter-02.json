{
  "id": "chapter-02",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "Chapter 2",
  "title": "The Illusion of Memory Ownership",
  "shortTitle": "The Illusion of Memory Ownership",
  "sourceRange": [
