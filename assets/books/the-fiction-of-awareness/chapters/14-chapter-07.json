  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar Chapter 6 mein self-story collapse hoti hui dikhi thi…"
        }
      ],
      "sourceParagraph": 613
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ab ek aur deeper shift aata hai:"
        }
      ],
      "sourceParagraph": 614
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo “collapse dekh raha tha” — uska bhi koi fixed form nahi milta."
        }
      ],
      "sourceParagraph": 615
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum aksar sochte hain ki ek “witness” hoga…"
        }
      ],
      "sourceParagraph": 616
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo thoughts ko dekh raha hai…"
        }
      ],
      "sourceParagraph": 617
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "emotions ko observe kar raha hai…"
        }
      ],
      "sourceParagraph": 618
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur life ko experience kar raha hai."
        }
      ],
      "sourceParagraph": 619
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin jab is witness ko directly search kiya jaye…"
        }
      ],
      "sourceParagraph": 620
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange silence milta hai."
        }
      ],
      "sourceParagraph": 621
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi shape."
        }
      ],
      "sourceParagraph": 622
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi location."
        }
      ],
      "sourceParagraph": 623
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na koi fixed identity."
        }
      ],
      "sourceParagraph": 624
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf awareness jaisa “presentness” hota hai…"
        }
      ],
      "sourceParagraph": 625
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "lekin usko bhi kisi entity mein convert nahi kiya ja sakta."
        }
      ],
      "sourceParagraph": 626
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe final illusion break hota hai:"
        }
      ],
      "sourceParagraph": 627
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“there is someone who is aware”"
        }
      ],
      "sourceParagraph": 628
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin awareness ke andar “someone” kabhi found nahi hota."
        }
      ],
      "sourceParagraph": 629
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf awareness hoti hai."
        }
      ],
      "sourceParagraph": 630
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without owner."
        }
      ],
      "sourceParagraph": 631
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without center."
        }
      ],
      "sourceParagraph": 632
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without name."
        }
      ],
      "sourceParagraph": 633
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Thoughts aate hain…"
        }
      ],
      "sourceParagraph": 634
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par koi fixed thinker nahi milta."
        }
      ],
      "sourceParagraph": 635
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Memory appear hoti hai…"
        }
      ],
      "sourceParagraph": 636
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par koi permanent holder nahi milta."
        }
      ],
      "sourceParagraph": 637
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Experience unfold hota hai…"
        }
      ],
      "sourceParagraph": 638
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "par koi central experiencer locate nahi hota."
        }
      ],
      "sourceParagraph": 639
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur phir ek aur layer dissolve hoti hai:"
        }
      ],
      "sourceParagraph": 640
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye idea ki “I am the witness”."
        }
      ],
      "sourceParagraph": 641
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki witness bhi ek subtle identity ban sakti hai."
        }
      ],
      "sourceParagraph": 642
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek refined ego form."
        }
      ],
      "sourceParagraph": 643
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin jab observation aur deep hota hai…"
        }
      ],
      "sourceParagraph": 644
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh even witness ko hold karne wala koi point nahi milta."
        }
      ],
      "sourceParagraph": 645
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf experiencing remains."
        }
      ],
      "sourceParagraph": 646
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without labeling."
        }
      ],
      "sourceParagraph": 647
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without separation."
        }
      ],
      "sourceParagraph": 648
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na “inside”"
        }
      ],
      "sourceParagraph": 649
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na “outside”"
        }
      ],
      "sourceParagraph": 650
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas appearance."
        }
      ],
      "sourceParagraph": 651
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye appearance kisi ko show nahi ho rahi hoti…"
        }
      ],
      "sourceParagraph": 652
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo bas ho rahi hoti hai."
        }
      ],
      "sourceParagraph": 653
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is stage pe language apni limit dikha deti hai…"
        }
      ],
      "sourceParagraph": 654
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki language hamesha “someone” assume karti hai."
        }
      ],
      "sourceParagraph": 655
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin yahan koi “someone” support nahi karta."
        }
      ],
      "sourceParagraph": 656
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye clear hota hai…"
        }
      ],
      "sourceParagraph": 657
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange simplicity bachi rehti hai:"
        }
      ],
      "sourceParagraph": 658
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na self."
        }
      ],
      "sourceParagraph": 659
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na witness."
        }
      ],
      "sourceParagraph": 660
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na story."
        }
      ],
      "sourceParagraph": 661
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na owner."
        }
      ],
      "sourceParagraph": 662
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf happening."
        }
      ],
      "sourceParagraph": 663
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye happening kisi ke liye nahi hoti…"
        }
      ],
      "sourceParagraph": 664
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki “koi” baaki nahi rehta jiske liye ho."
        }
      ],
      "sourceParagraph": 665
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye final realization koi conclusion nahi hota…"
        }
      ],
      "sourceParagraph": 666
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo ek disappearance of necessity hota hai."
        }
      ],
      "sourceParagraph": 667
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi ke saath Book I complete hoti hai:"
        }
      ],
      "sourceParagraph": 668
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The Fiction of Self was never about finding who you are…"
        }
      ],
      "sourceParagraph": 669
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but seeing that “who” was never required in the first place."
        }
      ],
      "sourceParagraph": 670
    }
  ],
