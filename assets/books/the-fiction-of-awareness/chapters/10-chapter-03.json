{
  "id": "chapter-03",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "Chapter 3",
  "title": "The Fiction of the Inner Voice",
  "shortTitle": "The Fiction of the Inner Voice",
  "sourceRange": [
    345,
    422
  ],
  "headerSourceParagraphs": {
    "number": 345,
    "title": 346
  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum sabko lagta hai ki andar ek “voice” chal rahi hoti hai."
        }
      ],
      "sourceParagraph": 347
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jo continuously comment karti rehti hai"
        }
      ],
      "sourceParagraph": 348
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sochti hai."
        }
      ],
      "sourceParagraph": 349
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Judge karti hai."
        }
      ],
      "sourceParagraph": 350
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Explain karti hai."
        }
      ],
      "sourceParagraph": 351
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar carefully dekha jaye…"
        }
      ],
      "sourceParagraph": 352
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ye “voice” koi actual voice nahi hoti."
        }
      ],
      "sourceParagraph": 353
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na sound hota hai"
        }
      ],
      "sourceParagraph": 354
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na speaker hota hai."
        }
      ],
      "sourceParagraph": 355
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na clear origin hota hai"
        }
      ],
      "sourceParagraph": 356
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ek thought stream hoti hai…"
        }
      ],
      "sourceParagraph": 357
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo language ke form mein appear hoti hai."
        }
      ],
      "sourceParagraph": 358
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur mind usko “inner voice” bana deta hai."
        }
      ],
      "sourceParagraph": 359
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe ek subtle illusion start hota hai:"
        }
      ],
      "sourceParagraph": 360
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "«“Main soch raha hoon”»"
        }
      ],
      "sourceParagraph": 361
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin reality mein aksar aisa hota hai ki:"
        }
      ],
      "sourceParagraph": 362
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "soch ho rahi hoti hai…"
        }
      ],
      "sourceParagraph": 363
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur uske baad “main” attach hota hai"
        }
      ],
      "sourceParagraph": 364
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Inner voice pehle nahi hota."
        }
      ],
      "sourceParagraph": 365
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo baad mein recognized hota hai."
        }
      ],
      "sourceParagraph": 366
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise hi koi thought aata hai…"
        }
      ],
      "sourceParagraph": 367
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "mind turant usko label karta hai"
        }
      ],
      "sourceParagraph": 368
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- ye mera thought hai"
        }
      ],
      "sourceParagraph": 369
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- main ye soch raha hoon"
        }
      ],
      "sourceParagraph": 370
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- main decide kar raha hoon"
        }
      ],
      "sourceParagraph": 371
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar thoda gap observe karo…"
        }
      ],
      "sourceParagraph": 372
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange thing dikhegi:"
        }
      ],
      "sourceParagraph": 373
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "thought apne aap arise ho raha hota hai"
        }
      ],
      "sourceParagraph": 374
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Uske pehle koi announcement nahi hoti."
        }
      ],
      "sourceParagraph": 375
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na permission."
        }
      ],
      "sourceParagraph": 376
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na intention."
        }
      ],
      "sourceParagraph": 377
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur phir bhi uske baad ek sense create hota hai:"
        }
      ],
      "sourceParagraph": 378
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“maine socha”"
        }
      ],
      "sourceParagraph": 379
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is sense ko hi hum “inner voice” samajh lete hain."
        }
      ],
      "sourceParagraph": 380
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ye voice actually continuous narration hai…"
        }
      ],
      "sourceParagraph": 381
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo automatically generate hoti rehti hai."
        }
      ],
      "sourceParagraph": 382
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur kyuki ye narration language mein hoti hai…"
        }
      ],
      "sourceParagraph": 383
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh lagta hai jaise koi “someone” bol raha ho."
        }
      ],
      "sourceParagraph": 384
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But agar deeply dekha jaye:"
        }
      ],
      "sourceParagraph": 385
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- koi speaker locate nahi hota"
        }
      ],
      "sourceParagraph": 386
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- koi origin point nahi milta"
        }
      ],
      "sourceParagraph": 387
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "- sirf thoughts appear hote hain"
        }
      ],
      "sourceParagraph": 388
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Inner voice ka sabse strong illusion ye hai:"
        }
      ],
      "sourceParagraph": 389
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "«it feels like control center of self»"
        }
      ],
      "sourceParagraph": 390
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin control center khud ek output hai."
        }
      ],
      "sourceParagraph": 391
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Source nahi"
        }
      ],
      "sourceParagraph": 392
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Thoughts aate hain…"
        }
      ],
      "sourceParagraph": 393
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur un thoughts ke upar ek additional layer attach hoti hai:"
        }
      ],
      "sourceParagraph": 394
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“main ye dekh raha hoon”"
        }
      ],
      "sourceParagraph": 395
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us second layer ko hum awareness samajh lete hain."
        }
      ],
      "sourceParagraph": 396
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin wo awareness bhi ek thought-based interpretation hai."
        }
      ],
      "sourceParagraph": 397
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek label"
        }
      ],
      "sourceParagraph": 398
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek narrative position."
        }
      ],
      "sourceParagraph": 399
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye inner voice ek single entity nahi hai."
        }
      ],
      "sourceParagraph": 400
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye multiple fragments ka fast sequence hai…"
        }
      ],
      "sourceParagraph": 401
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo ek continuous conversation jaisa feel hota hai."
        }
      ],
      "sourceParagraph": 402
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur kyuki gap visible nahi hota…"
        }
      ],
      "sourceParagraph": 403
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "mind usko “I am thinking” ke form mein compress kar deta hai."
        }
      ],
      "sourceParagraph": 404
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But truth is:"
        }
      ],
      "sourceParagraph": 405
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "thinking is happening"
        }
      ],
      "sourceParagraph": 406
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "not someone thinking "
        }
      ],
      "sourceParagraph": 407
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye difference subtle hai…"
        }
      ],
      "sourceParagraph": 408
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "lekin entire identity structure isi pe based hai."
        }
      ],
      "sourceParagraph": 409
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki agar “someone thinking” collapse ho jaye…"
        }
      ],
      "sourceParagraph": 410
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh “thinker” bhi dissolve ho jata hai"
        }
      ],
      "sourceParagraph": 411
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab thinker dissolve hota hai…"
        }
      ],
      "sourceParagraph": 412
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh sirf thinking bachi rehti hai."
        }
      ],
      "sourceParagraph": 413
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "without ownership."
        }
      ],
      "sourceParagraph": 414
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "without center."
        }
      ],
      "sourceParagraph": 415
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Inner voice ka fiction yahin se break hota hai"
        }
      ],
      "sourceParagraph": 416
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "«voice was never a voice"
        }
      ],
      "sourceParagraph": 417
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "it was always just thought pretending continuity»"
        }
      ],
      "sourceParagraph": 418
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye clear hota hai…"
        }
      ],
      "sourceParagraph": 419
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange silence aata hai…"
        }
      ],
      "sourceParagraph": 420
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jahan pe koi internal narrator nahi hota…"
        }
      ],
      "sourceParagraph": 421
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf happening hoti hai."
        }
      ],
      "sourceParagraph": 422
    }
  ],
