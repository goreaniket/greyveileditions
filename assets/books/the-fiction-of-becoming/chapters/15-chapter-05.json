  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum healing ko ek final state samajh lete hain…"
        }
      ],
      "sourceParagraph": 445
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jaise ek point ho jahan sab theek ho jayega."
        }
      ],
      "sourceParagraph": 446
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar healing ko closely observe kiya jaye…"
        }
      ],
      "sourceParagraph": 447
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo koi fixed end-state nahi hoti."
        }
      ],
      "sourceParagraph": 448
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo ek continuous interpretation shift hota hai."
        }
      ],
      "sourceParagraph": 449
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek experience hota hai jo painful lagta hai…"
        }
      ],
      "sourceParagraph": 450
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur usko hum “damage” label kar dete hain."
        }
      ],
      "sourceParagraph": 451
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Phir ek future imagine hota hai:"
        }
      ],
      "sourceParagraph": 452
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“jab main heal ho jaunga…”"
        }
      ],
      "sourceParagraph": 453
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin is imagination ke andar ek hidden structure hota hai:"
        }
      ],
      "sourceParagraph": 454
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present self ko broken maanna"
        }
      ],
      "sourceParagraph": 455
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Healing ka process aksar aise chalta hai:"
        }
      ],
      "sourceParagraph": 456
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "pain occur hota hai"
        }
      ],
      "sourceParagraph": 457
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "label attach hota hai (“trauma”, “hurt”, “damage”)"
        }
      ],
      "sourceParagraph": 458
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "identity form hoti hai (“I am broken”)"
        }
      ],
      "sourceParagraph": 459
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "future self imagine hota hai (“I will be healed”)"
        }
      ],
      "sourceParagraph": 460
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "continuous self-monitoring start hoti hai"
        }
      ],
      "sourceParagraph": 461
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "loop repeat hota hai"
        }
      ],
      "sourceParagraph": 462
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Healing ka idea khud ek comparison system pe based hota hai:"
        }
      ],
      "sourceParagraph": 463
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present self vs ideal healed self"
        }
      ],
      "sourceParagraph": 464
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jahan comparison hota hai…"
        }
      ],
      "sourceParagraph": 465
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wahan incompleteness automatic hoti hai."
        }
      ],
      "sourceParagraph": 466
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jo cheez healing lagti hai…"
        }
      ],
      "sourceParagraph": 467
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo kabhi kabhi sirf:"
        }
      ],
      "sourceParagraph": 468
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "reinterpretation"
        }
      ],
      "sourceParagraph": 469
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "reframing"
        }
      ],
      "sourceParagraph": 470
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "meaning restructuring"
        }
      ],
      "sourceParagraph": 471
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hoti hai."
        }
      ],
      "sourceParagraph": 472
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Experience change nahi hota…"
        }
      ],
      "sourceParagraph": 473
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "uska story change hota hai."
        }
      ],
      "sourceParagraph": 474
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Pain ko jab meaning diya jata hai…"
        }
      ],
      "sourceParagraph": 475
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo ek identity ban jata hai."
        }
      ],
      "sourceParagraph": 476
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab identity ban jati hai…"
        }
      ],
      "sourceParagraph": 477
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh healing us identity ko sustain karne ka process ban sakta hai."
        }
      ],
      "sourceParagraph": 478
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "pain → meaning → identity (“I am hurt”) → future healing image → effort → temporary relief → re-labeling → repeat"
        }
      ],
      "sourceParagraph": 479
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar pain ko bina interpretation ke dekha jaye…"
        }
      ],
      "sourceParagraph": 480
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo sirf sensation + thought flow hota hai."
        }
      ],
      "sourceParagraph": 481
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na permanent story."
        }
      ],
      "sourceParagraph": 482
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na fixed identity."
        }
      ],
      "sourceParagraph": 483
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Healing tab radically change hoti hai…"
        }
      ],
      "sourceParagraph": 484
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jab “broken self” idea weaken hota hai."
        }
      ],
      "sourceParagraph": 485
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki agar koi fixed broken self hi nahi…"
        }
      ],
      "sourceParagraph": 486
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh fixed healed self bhi nahi ho sakta."
        }
      ],
      "sourceParagraph": 487
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Healing ka deepest shift ye hota hai:"
        }
      ],
      "sourceParagraph": 488
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience ko repair karna nahi…"
        }
      ],
      "sourceParagraph": 489
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience ko ownership se free dekhna."
        }
      ],
      "sourceParagraph": 490
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ownership drop hoti hai…"
        }
      ],
      "sourceParagraph": 491
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh pain ka weight change ho jata hai."
        }
      ],
      "sourceParagraph": 492
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na because it disappeared…"
        }
      ],
      "sourceParagraph": 493
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but because it is no longer claimed as “mine story”."
        }
      ],
      "sourceParagraph": 494
    }
