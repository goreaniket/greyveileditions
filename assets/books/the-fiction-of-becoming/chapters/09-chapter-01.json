  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum apne aap ko aksar present mein nahi dekhte…"
        }
      ],
      "sourceParagraph": 214
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum apne aap ko future ke through dekhte hain."
        }
      ],
      "sourceParagraph": 215
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek invisible image continuously chal rahi hoti hai:"
        }
      ],
      "sourceParagraph": 216
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main aage jaake kya banunga”"
        }
      ],
      "sourceParagraph": 217
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye image itni natural lagti hai…"
        }
      ],
      "sourceParagraph": 218
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki hum usko imagination nahi samajhte."
        }
      ],
      "sourceParagraph": 219
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum usko direction samajhte hain."
        }
      ],
      "sourceParagraph": 220
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar closely dekha jaye…"
        }
      ],
      "sourceParagraph": 221
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh jo “future self” hai…"
        }
      ],
      "sourceParagraph": 222
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo present experience mein exist hi nahi karta."
        }
      ],
      "sourceParagraph": 223
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf ek mental projection hota hai."
        }
      ],
      "sourceParagraph": 224
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind ek current moment ko uthata hai…"
        }
      ],
      "sourceParagraph": 225
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur usko forward time mein extend kar deta hai."
        }
      ],
      "sourceParagraph": 226
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur phir ek character create hota hai:"
        }
      ],
      "sourceParagraph": 227
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "better version of me"
        }
      ],
      "sourceParagraph": 228
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "successful version of me"
        }
      ],
      "sourceParagraph": 229
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "healed version of me"
        }
      ],
      "sourceParagraph": 230
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "complete version of me"
        }
      ],
      "sourceParagraph": 231
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin interesting baat ye hai:"
        }
      ],
      "sourceParagraph": 232
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye “version” kabhi available nahi hota."
        }
      ],
      "sourceParagraph": 233
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo hamesha ahead rehta hai."
        }
      ],
      "sourceParagraph": 234
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi “ahead” hone ki wajah se…"
        }
      ],
      "sourceParagraph": 235
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo ek permanent motivation ban jata hai."
        }
      ],
      "sourceParagraph": 236
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum chase karte rehte hain…"
        }
      ],
      "sourceParagraph": 237
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek identity ko jo abhi exist nahi karti."
        }
      ],
      "sourceParagraph": 238
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur is chasing mein…"
        }
      ],
      "sourceParagraph": 239
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present experience secondary ho jata hai."
        }
      ],
      "sourceParagraph": 240
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Becoming ka illusion yahan se start hota hai:"
        }
      ],
      "sourceParagraph": 241
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki jo main hoon abhi…"
        }
      ],
      "sourceParagraph": 242
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo enough nahi hai."
        }
      ],
      "sourceParagraph": 243
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jo main banunga…"
        }
      ],
      "sourceParagraph": 244
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo real main hoga."
        }
      ],
      "sourceParagraph": 245
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin “real main” hamesha future mein shift hota rehta hai."
        }
      ],
      "sourceParagraph": 246
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye becoming kabhi complete nahi hota."
        }
      ],
      "sourceParagraph": 247
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo ek moving horizon hota hai."
        }
      ],
      "sourceParagraph": 248
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum jitna uske paas jaate ho…"
        }
      ],
      "sourceParagraph": 249
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo utna hi door chala jata hai."
        }
      ],
      "sourceParagraph": 250
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur mind is movement ko progress samajhta hai."
        }
      ],
      "sourceParagraph": 251
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar deeply dekha jaye…"
        }
      ],
      "sourceParagraph": 252
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ye progress nahi…"
        }
      ],
      "sourceParagraph": 253
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye delay system hai."
        }
      ],
      "sourceParagraph": 254
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek continuous postponement of being."
        }
      ],
      "sourceParagraph": 255
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye clearly dikhta hai…"
        }
      ],
      "sourceParagraph": 256
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange realization aata hai:"
        }
      ],
      "sourceParagraph": 257
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo “I will become” hai…"
        }
      ],
      "sourceParagraph": 258
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo actually “I am avoiding what is” bhi ho sakta hai."
        }
      ],
      "sourceParagraph": 259
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur present moment…"
        }
      ],
      "sourceParagraph": 260
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kabhi insufficient nahi hota."
        }
      ],
      "sourceParagraph": 261
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Bas comparison usko insufficient bana deta hai."
        }
      ],
      "sourceParagraph": 262
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur comparison ka root hamesha future image hota hai."
        }
      ],
      "sourceParagraph": 263
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye “who I will become” ek innocent thought nahi hai…"
        }
      ],
      "sourceParagraph": 264
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye ek identity engine hai."
        }
      ],
      "sourceParagraph": 265
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jo present ko redefine karta rehta hai…"
        }
      ],
      "sourceParagraph": 266
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "future ke lens se."
        }
      ],
      "sourceParagraph": 267
    }
