    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum achievements ko sirf results nahi samajhte…"
        }
      ],
      "sourceParagraph": 391
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum unko apni identity ka proof bana dete hain."
        }
      ],
      "sourceParagraph": 392
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek simple kaam hota hai:"
        }
      ],
      "sourceParagraph": 393
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kuch achieve karna, kuch prove karna, kuch reach karna."
        }
      ],
      "sourceParagraph": 394
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin mind iske around ek deeper structure build kar deta hai:"
        }
      ],
      "sourceParagraph": 395
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main tab hi valid hoon jab main achieve kar raha hoon”"
        }
      ],
      "sourceParagraph": 396
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin se cycle start hota hai."
