      "sourceParagraph": 426
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "lack → effort → achievement → normalization → new lack → repeat"
        }
      ],
      "sourceParagraph": 427
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye loop kabhi stop nahi hota…"
        }
      ],
      "sourceParagraph": 428
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki ideal self hamesha moving hota hai."
        }
      ],
      "sourceParagraph": 429
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Achievement ka asli function external success nahi hai…"
        }
      ],
      "sourceParagraph": 430
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "internal incompleteness ko manage karna hai."
        }
      ],
      "sourceParagraph": 431
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye structure visible hota hai…"
        }
      ],
      "sourceParagraph": 432
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh achievement ka emotional weight gir jata hai."
        }
      ],
      "sourceParagraph": 433
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na motivation disappear hota hai…"
