      ],
      "sourceParagraph": 420
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "self-worth stabilize karne ke liye"
        }
      ],
      "sourceParagraph": 421
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "identity validate karne ke liye"
        }
      ],
      "sourceParagraph": 422
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "inner emptiness cover karne ke liye"
        }
      ],
      "sourceParagraph": 423
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin paradox ye hai:"
        }
      ],
      "sourceParagraph": 424
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jitna achievement hota hai…"
        }
