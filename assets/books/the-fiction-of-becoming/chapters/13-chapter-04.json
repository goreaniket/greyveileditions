      "sourceParagraph": 416
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo sirf temporary relief deta hai."
        }
      ],
      "sourceParagraph": 417
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur relief ke baad…"
        }
      ],
      "sourceParagraph": 418
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "gap wapas aa jata hai."
        }
      ],
      "sourceParagraph": 419
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind achievement ko use karta hai:"
