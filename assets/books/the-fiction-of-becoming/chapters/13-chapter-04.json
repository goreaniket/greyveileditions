      "sourceParagraph": 403
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "complete me"
        }
      ],
      "sourceParagraph": 404
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "3. STRIVING PHASE",
          "bold": true
        }
      ],
      "sourceParagraph": 405
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Effort start hota hai."
        }
      ],
      "sourceParagraph": 406
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Energy direction le leti hai."
        }
      ],
      "sourceParagraph": 407
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "4. ACHIEVEMENT MOMENT",
