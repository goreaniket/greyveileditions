  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har insaan ke andar ek silent current chal raha hota hai…"
        }
      ],
      "sourceParagraph": 128
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo kabhi rest nahi leta."
        }
      ],
      "sourceParagraph": 129
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye current ek simple question se start hota hai:"
        }
      ],
      "sourceParagraph": 130
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Main kya banunga?”"
        }
      ],
      "sourceParagraph": 131
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ye question utna innocent nahi hota jitna lagta hai."
        }
      ],
      "sourceParagraph": 132
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Iske andar ek hidden assumption hota hai:"
        }
      ],
      "sourceParagraph": 133
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Jo main ab hoon… wo final nahi hai.”"
        }
      ],
      "sourceParagraph": 134
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahi assumption poore human experience ko shape karta hai."
        }
      ],
      "sourceParagraph": 135
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek future version hamesha present ke saath chalta rehta hai."
        }
      ],
      "sourceParagraph": 136
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo visible nahi hota…"
        }
      ],
      "sourceParagraph": 137
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "lekin feel hota hai."
        }
      ],
      "sourceParagraph": 138
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "better me"
        }
      ],
      "sourceParagraph": 139
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "stronger me"
        }
      ],
      "sourceParagraph": 140
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "healed me"
        }
      ],
      "sourceParagraph": 141
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "successful me"
        }
      ],
      "sourceParagraph": 142
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "complete me"
        }
      ],
      "sourceParagraph": 143
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sab ek parallel existence ki tarah present ke saath rehte hain."
        }
      ],
      "sourceParagraph": 144
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur present un sab ke against silently measured hota rehta hai."
        }
      ],
      "sourceParagraph": 145
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is structure mein koi bhi moment neutral nahi hota."
        }
      ],
      "sourceParagraph": 146
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har moment ek comparison field mein enter hota hai:"
        }
      ],
      "sourceParagraph": 147
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what I am vs what I should be"
        }
      ],
      "sourceParagraph": 148
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jahan “should be” exist karta hai…"
        }
      ],
      "sourceParagraph": 149
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wahan “is” kabhi enough nahi hota."
        }
      ],
      "sourceParagraph": 150
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Becoming koi event nahi hai…"
        }
      ],
      "sourceParagraph": 151
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye ek continuous psychological motion hai."
        }
      ],
      "sourceParagraph": 152
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek loop:"
        }
      ],
      "sourceParagraph": 153
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present experience"
        }
      ],
      "sourceParagraph": 154
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "future projection"
        }
      ],
      "sourceParagraph": 155
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "emotional gap"
        }
      ],
      "sourceParagraph": 156
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "effort"
        }
      ],
      "sourceParagraph": 157
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "temporary shift"
        }
      ],
      "sourceParagraph": 158
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "new projection"
        }
      ],
      "sourceParagraph": 159
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye loop itni smooth speed se chalta hai…"
        }
      ],
      "sourceParagraph": 160
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki lagta hai ye natural reality hai."
        }
      ],
      "sourceParagraph": 161
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum is motion ko “growth” kehte hain."
        }
      ],
      "sourceParagraph": 162
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“improvement” kehte hain."
        }
      ],
      "sourceParagraph": 163
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“journey” kehte hain."
        }
      ],
      "sourceParagraph": 164
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ek deeper observation ye hai:"
        }
      ],
      "sourceParagraph": 165
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "movement aur arrival same cheez nahi hote."
        }
      ],
      "sourceParagraph": 166
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur becoming aksar arrival create nahi karta…"
        }
      ],
      "sourceParagraph": 167
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo sirf next movement create karta hai."
        }
      ],
      "sourceParagraph": 168
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " THE INNER STRUCTURE",
          "bold": true
        }
      ],
      "sourceParagraph": 169,
      "role": "section-heading"
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Becoming ka sabse subtle layer ye hai:"
        }
      ],
      "sourceParagraph": 170
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "present ko incomplete feel karwana."
        }
      ],
      "sourceParagraph": 171
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab present incomplete lagta hai…"
        }
      ],
      "sourceParagraph": 172
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek invisible urgency activate hoti hai:"
        }
      ],
      "sourceParagraph": 173
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“abhi kuch aur hona chahiye.”"
        }
      ],
      "sourceParagraph": 174
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is urgency ke andar hi poora psychological identity system build hota hai."
        }
      ],
      "sourceParagraph": 175
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "self-worth"
        }
      ],
      "sourceParagraph": 176
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ambition"
        }
      ],
      "sourceParagraph": 177
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "failure"
        }
      ],
      "sourceParagraph": 178
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "success"
        }
      ],
      "sourceParagraph": 179
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "healing"
        }
      ],
      "sourceParagraph": 180
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "transformation"
        }
      ],
      "sourceParagraph": 181
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sab isi movement ke different expressions hain."
        }
      ],
      "sourceParagraph": 182
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar thoda aur silently dekha jaye…"
        }
      ],
      "sourceParagraph": 183
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange possibility open hoti hai:"
        }
      ],
      "sourceParagraph": 184
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo “becoming” lagta hai…"
        }
      ],
      "sourceParagraph": 185
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo actually “avoiding the present” bhi ho sakta hai."
        }
      ],
      "sourceParagraph": 186
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jo “present” lagta hai…"
        }
      ],
      "sourceParagraph": 187
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo already complete experience ho sakta hai…"
        }
      ],
      "sourceParagraph": 188
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "bina kisi future definition ke."
        }
      ],
      "sourceParagraph": 189
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is book ka purpose ye nahi hai ki tumhe stop kar de."
        }
      ],
      "sourceParagraph": 190
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na goals ko reject karna."
        }
      ],
      "sourceParagraph": 191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na life ko deny karna."
        }
      ],
      "sourceParagraph": 192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ek subtle shift point dikhata hai:"
        }
      ],
      "sourceParagraph": 193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki jo movement tumhe define karta hai…"
        }
      ],
      "sourceParagraph": 194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo tum ho nahi."
        }
      ],
      "sourceParagraph": 195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jab becoming clearly visible ho jata hai…"
        }
      ],
      "sourceParagraph": 196
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange clarity aati hai:"
        }
      ],
      "sourceParagraph": 197
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tum kisi cheez ki taraf ja nahi rahe…"
        }
      ],
      "sourceParagraph": 198
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "tum sirf ek continuous unfolding ko interpret kar rahe ho."
        }
      ],
      "sourceParagraph": 199
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab interpretation soft hota hai…"
        }
      ],
      "sourceParagraph": 200
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh experience apne aap zyada direct lagne lagta hai."
        }
      ],
      "sourceParagraph": 201
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na pressure."
        }
      ],
      "sourceParagraph": 202
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na comparison."
        }
      ],
      "sourceParagraph": 203
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na hidden finish line."
        }
      ],
      "sourceParagraph": 204
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf movement…"
        }
      ],
      "sourceParagraph": 205
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo already ho raha hai."
        }
      ],
      "sourceParagraph": 206
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin se Book III ka observation start hota hai:"
        }
      ],
      "sourceParagraph": 207
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "not to reach a final version of yourself…"
        }
      ],
      "sourceParagraph": 208
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but to see why “final version” was ever needed in the first place."
        }
      ],
      "sourceParagraph": 209
    }
