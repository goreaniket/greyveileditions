{
  "id": "chapter-03",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "Chapter 3",
  "title": "The Fiction of Growth",
  "shortTitle": "The Fiction of Growth",
  "sourceRange": [
    338,
