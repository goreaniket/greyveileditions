      "sourceParagraph": 522
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "future ko “fixing project” bana diya jaye"
        }
      ],
      "sourceParagraph": 523
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur is combination se ek stable story emerge hoti hai:"
        }
      ],
      "sourceParagraph": 524
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Something is fundamentally wrong with me”"
        }
      ],
      "sourceParagraph": 525
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memory → interpretation → identity label → perception filter → confirmation bias → stronger identity"
        }
      ],
      "sourceParagraph": 526
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar observation thoda clear ho jaye…"
        }
      ],
      "sourceParagraph": 527
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange gap dikhta hai:"
        }
      ],
      "sourceParagraph": 528
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience aur story ek cheez nahi hain."
        }
      ],
      "sourceParagraph": 529
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Experience sirf hota hai…"
        }
      ],
      "sourceParagraph": 530
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "story usko define karti hai."
        }
      ],
      "sourceParagraph": 531
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Broken self narrative tab weak hota hai…"
        }
      ],
      "sourceParagraph": 532
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jab har experience ko “proof” ki tarah use karna band ho jata hai."
