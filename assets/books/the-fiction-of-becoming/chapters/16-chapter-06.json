      "sourceParagraph": 511
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "painful moment → “proof of brokenness”"
        }
      ],
      "sourceParagraph": 512
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi asymmetric filtering se narrative strong hota jata hai."
        }
      ],
      "sourceParagraph": 513
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Broken self koi fixed entity nahi hota…"
        }
      ],
      "sourceParagraph": 514
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye selective interpretation ka result hota hai."
        }
      ],
      "sourceParagraph": 515
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind sirf kuch moments ko highlight karta hai…"
