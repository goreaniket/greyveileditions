  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is book ko padhne se pehle…"
        }
      ],
      "sourceParagraph": 85
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek baat samajh lo."
        }
      ],
      "sourceParagraph": 86
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jo bhi tum apne baare mein “jaante” ho…"
        }
      ],
      "sourceParagraph": 87
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "woh direct truth nahi hai."
        }
      ],
      "sourceParagraph": 88
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Woh filtered hai."
        }
      ],
      "sourceParagraph": 89
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Filter kis cheez ka?"
        }
      ],
      "sourceParagraph": 90
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "interpretation ka"
        }
      ],
      "sourceParagraph": 91
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "fear ka"
        }
      ],
      "sourceParagraph": 92
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "past experience ka"
        }
      ],
      "sourceParagraph": 93
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur tumhari apni expectations ka"
        }
      ],
      "sourceParagraph": 94
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tumne kabhi reality ko raw form mein nahi dekha."
        }
      ],
      "sourceParagraph": 95
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tumne sirf uska meaning dekha hai."
        }
      ],
      "sourceParagraph": 96
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur dheere dheere…"
        }
      ],
      "sourceParagraph": 97
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "yeh filter itna normal ban gaya…"
        }
      ],
      "sourceParagraph": 98
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki tumhe lagta hai yeh hi “tum” ho."
        }
      ],
      "sourceParagraph": 99
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Is book ka purpose tumhe kuch naya dena nahi hai."
        }
      ],
      "sourceParagraph": 100
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Iska purpose tumhari ek purani cheez disturb karna hai:"
        }
      ],
      "sourceParagraph": 101
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "automatic interpretation system"
        }
      ],
      "sourceParagraph": 102
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki real question yeh nahi hai:"
        }
      ],
      "sourceParagraph": 103
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“Life kya hai?”"
        }
      ],
      "sourceParagraph": 104
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Real question yeh hai:"
        }
      ],
      "sourceParagraph": 105
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“Kaun hai jo tumhare andar har cheez ko meaning bana raha hai?”"
        }
      ],
      "sourceParagraph": 106
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur agar tum yahan comfort dhoondhne aaye ho…"
        }
      ],
      "sourceParagraph": 107
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh tum already us illusion ke andar ho jisse yeh book break karna chahti hai."
        }
      ],
      "sourceParagraph": 108
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye jaldi mat padhna."
        }
      ],
      "sourceParagraph": 109
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki fast reading mind ko bachati hai."
        }
      ],
      "sourceParagraph": 110
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur slow reading mind ko expose karti hai."
        }
      ],
      "sourceParagraph": 111
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jo aage aayega…"
        }
      ],
      "sourceParagraph": 112
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "woh information nahi hai."
        }
      ],
      "sourceParagraph": 113
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Woh observation hai."
        }
      ],
      "sourceParagraph": 114
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur observation dangerous hoti hai…"
        }
      ],
      "sourceParagraph": 115
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki woh belief ko survive nahi karne deti."
        }
      ],
      "sourceParagraph": 116
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Toh simple si baat:"
        }
      ],
      "sourceParagraph": 117
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": " Tum kisi story mein enter nahi kar rahe ho."
        }
      ],
      "sourceParagraph": 118
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Tum ek mirror ke andar enter kar rahe ho."
        }
      ],
      "sourceParagraph": 119
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur mirror explain nahi karta…"
        }
      ],
      "sourceParagraph": 120
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf dikhata hai."
        }
      ],
      "sourceParagraph": 121
    }
  ],
