      "sourceParagraph": 1312
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“What is happening inside me right now?”"
        }
      ],
      "sourceParagraph": 1313
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh shift chhota nahi hota."
        }
      ],
      "sourceParagraph": 1314
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Yeh identity ka gravity break karta hai."
        }
