{
  "id": "chapter-03",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "CHAPTER 3-",
  "title": "THE SELF THAT NEVER STAYS FIXED",
  "shortTitle": "THE SELF THAT NEVER STAYS FIXED",
  "sourceRange": [
