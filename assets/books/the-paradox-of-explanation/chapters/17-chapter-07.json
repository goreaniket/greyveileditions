  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "CHAPTER 7-",
  "title": "WHEN THE MIND STOPS EXPLAINING",
  "shortTitle": "WHEN THE MIND STOPS EXPLAINING",
  "sourceRange": [
