{
  "id": "chapter-09",
  "kind": "chapter",
  "sourceKind": "chapter",
  "label": "CHAPTER 9-",
  "title": "WHEN YOU MEET YOURSELF WITHOUT THE STORY",
  "shortTitle": "WHEN YOU MEET YOURSELF WITHOUT THE STORY",
  "sourceRange": [
    2084,
    2260
  ],
  "headerSourceParagraphs": {
    "number": 2084,
    "title": 2085
  },
  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "There comes a point in human life…"
        }
      ],
      "sourceParagraph": 2086
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "where the idea of “who I am” starts feeling less like truth…"
        }
      ],
      "sourceParagraph": 2087
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "and more like a story that has been repeated too many times."
        }
      ],
      "sourceParagraph": 2088
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not a lie."
        }
      ],
      "sourceParagraph": 2089
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But a construction."
        }
      ],
      "sourceParagraph": 2090
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A quiet collection of:"
        }
      ],
      "sourceParagraph": 2091
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "memories that stayed"
        }
      ],
      "sourceParagraph": 2092
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "emotions that repeated"
        }
      ],
      "sourceParagraph": 2093
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "decisions that left marks"
        }
      ],
      "sourceParagraph": 2094
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "labels that stuck"
        }
      ],
      "sourceParagraph": 2095
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "interpretations that never got questioned"
        }
      ],
      "sourceParagraph": 2096
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And slowly…"
        }
      ],
      "sourceParagraph": 2097
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "this collection becomes a person."
        }
      ],
      "sourceParagraph": 2098
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A personality."
        }
      ],
      "sourceParagraph": 2099
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A self-image."
        }
      ],
      "sourceParagraph": 2100
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A “me”."
        }
      ],
      "sourceParagraph": 2101
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And for most of life…"
        }
      ],
      "sourceParagraph": 2102
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you don’t meet yourself directly."
        }
      ],
      "sourceParagraph": 2103
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You meet this constructed version."
        }
      ],
      "sourceParagraph": 2104
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You don’t say:"
        }
      ],
      "sourceParagraph": 2105
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“I am experiencing sadness.”"
        }
      ],
      "sourceParagraph": 2106
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You say:"
        }
      ],
      "sourceParagraph": 2107
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“I am a sad person.”"
        }
      ],
      "sourceParagraph": 2108
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You don’t say:"
        }
      ],
      "sourceParagraph": 2109
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“I made a mistake.”"
        }
      ],
      "sourceParagraph": 2110
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You say:"
        }
      ],
      "sourceParagraph": 2111
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“I always mess things up.”"
        }
      ],
      "sourceParagraph": 2112
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You don’t say:"
        }
      ],
      "sourceParagraph": 2113
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“I felt rejected.”"
        }
      ],
      "sourceParagraph": 2114
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You say:"
        }
      ],
      "sourceParagraph": 2115
    },
    {
      "type": "blockquote",
      "runs": [
        {
          "text": "“People don’t choose me.”"
        }
      ],
      "sourceParagraph": 2116
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in this small shift…"
        }
      ],
      "sourceParagraph": 2117
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience becomes identity."
        }
      ],
      "sourceParagraph": 2118
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Moment becomes personality."
        }
      ],
      "sourceParagraph": 2119
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Event becomes definition."
        }
      ],
      "sourceParagraph": 2120
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And that is how a story is built."
        }
      ],
      "sourceParagraph": 2121
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Quietly."
        }
      ],
      "sourceParagraph": 2122
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Repeatedly."
        }
      ],
      "sourceParagraph": 2123
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Unnoticed."
        }
      ],
      "sourceParagraph": 2124
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "At first, this story feels helpful."
        }
      ],
      "sourceParagraph": 2125
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because chaos becomes structured."
        }
      ],
      "sourceParagraph": 2126
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Pain becomes explainable."
        }
      ],
      "sourceParagraph": 2127
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Life becomes narratable."
        }
      ],
      "sourceParagraph": 2128
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And human mind loves narration."
        }
      ],
      "sourceParagraph": 2129
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because narration reduces uncertainty."
        }
      ],
      "sourceParagraph": 2130
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Uncertainty feels like danger."
        }
      ],
      "sourceParagraph": 2131
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Story feels like control."
        }
      ],
      "sourceParagraph": 2132
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But slowly…"
        }
      ],
      "sourceParagraph": 2133
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "something changes."
        }
      ],
      "sourceParagraph": 2134
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The story starts running even when life is not happening."
        }
      ],
      "sourceParagraph": 2135
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Even when nothing is wrong."
        }
      ],
      "sourceParagraph": 2136
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Even when nothing is happening at all."
        }
      ],
      "sourceParagraph": 2137
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The mind keeps describing:"
        }
      ],
      "sourceParagraph": 2138
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what you are"
        }
      ],
      "sourceParagraph": 2139
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what you should be"
        }
      ],
      "sourceParagraph": 2140
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what went wrong"
        }
      ],
      "sourceParagraph": 2141
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what might go wrong"
        }
      ],
      "sourceParagraph": 2142
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what others think"
        }
      ],
      "sourceParagraph": 2143
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "what you lack"
        }
      ],
      "sourceParagraph": 2144
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And without realizing it…"
        }
      ],
      "sourceParagraph": 2145
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you stop meeting life."
        }
      ],
      "sourceParagraph": 2146
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You start meeting interpretation of life."
        }
      ],
      "sourceParagraph": 2147
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And this interpretation becomes so continuous…"
        }
      ],
      "sourceParagraph": 2148
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "that silence feels strange."
        }
      ],
      "sourceParagraph": 2149
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Stillness feels suspicious."
        }
      ],
      "sourceParagraph": 2150
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Non-thinking feels empty."
        }
      ],
      "sourceParagraph": 2151
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because identity was never built on being…"
        }
      ],
      "sourceParagraph": 2152
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "it was built on thinking about being."
        }
      ],
      "sourceParagraph": 2153
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And then one day…"
        }
      ],
      "sourceParagraph": 2154
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "something very subtle breaks."
        }
      ],
      "sourceParagraph": 2155
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not externally."
        }
      ],
      "sourceParagraph": 2156
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But internally."
        }
      ],
      "sourceParagraph": 2157
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A moment arrives where:"
        }
      ],
      "sourceParagraph": 2158
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You are not actively defining yourself."
        }
      ],
      "sourceParagraph": 2159
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not judging yourself."
        }
      ],
      "sourceParagraph": 2160
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not explaining yourself."
        }
      ],
      "sourceParagraph": 2161
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not narrating yourself."
        }
      ],
      "sourceParagraph": 2162
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And still…"
        }
      ],
      "sourceParagraph": 2163
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you are here."
        }
      ],
      "sourceParagraph": 2164
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Breathing."
        }
      ],
      "sourceParagraph": 2165
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aware."
        }
      ],
      "sourceParagraph": 2166
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Present."
        }
      ],
      "sourceParagraph": 2167
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without a sentence running in the background."
        }
      ],
      "sourceParagraph": 2168
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And this creates a shock that is not emotional…"
        }
      ],
      "sourceParagraph": 2169
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but existential."
        }
      ],
      "sourceParagraph": 2170
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because if you are not the story running in your mind…"
        }
      ],
      "sourceParagraph": 2171
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "then what exactly are you?"
        }
      ],
      "sourceParagraph": 2172
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The mind immediately tries to answer."
        }
      ],
      "sourceParagraph": 2173
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It produces labels:"
        }
      ],
      "sourceParagraph": 2174
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "personality"
        }
      ],
      "sourceParagraph": 2175
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "soul"
        }
      ],
      "sourceParagraph": 2176
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "identity"
        }
      ],
      "sourceParagraph": 2177
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "past"
        }
      ],
      "sourceParagraph": 2178
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "nature"
        }
      ],
      "sourceParagraph": 2179
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "behavior patterns"
        }
      ],
      "sourceParagraph": 2180
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But every answer feels slightly off."
        }
      ],
      "sourceParagraph": 2181
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not wrong."
        }
      ],
      "sourceParagraph": 2182
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Just smaller than experience itself."
        }
      ],
      "sourceParagraph": 2183
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because what is being experienced right now…"
        }
      ],
      "sourceParagraph": 2184
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "cannot fit inside any definition."
        }
      ],
      "sourceParagraph": 2185
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And for the first time…"
        }
      ],
      "sourceParagraph": 2186
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you notice something unusual:"
        }
      ],
      "sourceParagraph": 2187
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You exist even without explaining yourself."
        }
      ],
      "sourceParagraph": 2188
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not as a concept."
        }
      ],
      "sourceParagraph": 2189
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not as a conclusion."
        }
      ],
      "sourceParagraph": 2190
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But as simple presence."
        }
      ],
      "sourceParagraph": 2191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And this presence does not need validation."
        }
      ],
      "sourceParagraph": 2192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It does not need history."
        }
      ],
      "sourceParagraph": 2193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It does not need justification."
        }
      ],
      "sourceParagraph": 2194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It does not need explanation."
        }
      ],
      "sourceParagraph": 2195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is not trying to become someone."
        }
      ],
      "sourceParagraph": 2196
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is not trying to fix someone."
        }
      ],
      "sourceParagraph": 2197
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is not trying to complete a narrative."
        }
      ],
      "sourceParagraph": 2198
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is simply aware."
        }
      ],
      "sourceParagraph": 2199
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And slowly…"
        }
      ],
      "sourceParagraph": 2200
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "a realization becomes unavoidable:"
        }
      ],
      "sourceParagraph": 2201
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You were never actually inside the story."
        }
      ],
      "sourceParagraph": 2202
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You were the space in which the story appeared."
        }
      ],
      "sourceParagraph": 2203
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The story changed."
        }
      ],
      "sourceParagraph": 2204
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The roles changed."
        }
      ],
      "sourceParagraph": 2205
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The emotions changed."
        }
      ],
      "sourceParagraph": 2206
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The memories changed."
        }
      ],
      "sourceParagraph": 2207
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The interpretations changed."
        }
      ],
      "sourceParagraph": 2208
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But something remained constant."
        }
      ],
      "sourceParagraph": 2209
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not as identity."
        }
      ],
      "sourceParagraph": 2210
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But as awareness of change."
        }
      ],
      "sourceParagraph": 2211
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And that awareness was never really noticed…"
        }
      ],
      "sourceParagraph": 2212
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "because attention was always absorbed inside content of life."
        }
      ],
      "sourceParagraph": 2213
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not the witnessing of it."
        }
      ],
      "sourceParagraph": 2214
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And now…"
        }
      ],
      "sourceParagraph": 2215
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "attention shifts slightly."
        }
      ],
      "sourceParagraph": 2216
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not away from life."
        }
      ],
      "sourceParagraph": 2217
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But away from automatic self-narration."
        }
      ],
      "sourceParagraph": 2218
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in that shift…"
        }
      ],
      "sourceParagraph": 2219
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "life feels strangely direct."
        }
      ],
      "sourceParagraph": 2220
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not emotional."
        }
      ],
      "sourceParagraph": 2221
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not philosophical."
        }
      ],
      "sourceParagraph": 2222
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Just immediate."
        }
      ],
      "sourceParagraph": 2223
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A moment is no longer “your memory”."
        }
      ],
      "sourceParagraph": 2224
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is just happening."
        }
      ],
      "sourceParagraph": 2225
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A feeling is no longer “your pattern”."
        }
      ],
      "sourceParagraph": 2226
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is just arising."
        }
      ],
      "sourceParagraph": 2227
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "A thought is no longer “your identity”."
        }
      ],
      "sourceParagraph": 2228
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "It is just appearing."
        }
      ],
      "sourceParagraph": 2229
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in this stripping away of ownership…"
        }
      ],
      "sourceParagraph": 2230
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "something unexpected happens."
        }
      ],
      "sourceParagraph": 2231
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Life becomes lighter."
        }
      ],
      "sourceParagraph": 2232
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not because problems disappear."
        }
      ],
      "sourceParagraph": 2233
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But because they are no longer being turned into identity."
        }
      ],
      "sourceParagraph": 2234
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in that lightness…"
        }
      ],
      "sourceParagraph": 2235
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you begin to see:"
        }
      ],
      "sourceParagraph": 2236
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Every story you told about yourself…"
        }
      ],
      "sourceParagraph": 2237
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "was an interpretation of something that was never fully captured."
        }
      ],
      "sourceParagraph": 2238
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because life was always moving."
        }
      ],
      "sourceParagraph": 2239
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But identity was always freezing it."
        }
      ],
      "sourceParagraph": 2240
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And what you called “me”…"
        }
      ],
      "sourceParagraph": 2241
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "was mostly a frozen explanation of a moving reality."
        }
      ],
      "sourceParagraph": 2242
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And now that freezing loosens…"
        }
      ],
      "sourceParagraph": 2243
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "something deeper becomes visible."
        }
      ],
      "sourceParagraph": 2244
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not a new identity."
        }
      ],
      "sourceParagraph": 2245
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But the absence of need for one."
        }
      ],
      "sourceParagraph": 2246
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in that absence…"
        }
      ],
      "sourceParagraph": 2247
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "there is no pressure to define yourself completely."
        }
      ],
      "sourceParagraph": 2248
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "No pressure to finalize who you are."
        }
      ],
      "sourceParagraph": 2249
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "No pressure to become a fixed idea."
        }
      ],
      "sourceParagraph": 2250
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Because nothing living is ever fully complete as a story."
        }
      ],
      "sourceParagraph": 2251
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Only as experience."
        }
      ],
      "sourceParagraph": 2252
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And maybe that was the misunderstanding all along:"
        }
      ],
      "sourceParagraph": 2253
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You were not meant to be finished."
        }
      ],
      "sourceParagraph": 2254
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "You were meant to be lived."
        }
      ],
      "sourceParagraph": 2255
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "And in that realization…"
        }
      ],
      "sourceParagraph": 2256
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "you meet yourself again."
        }
      ],
      "sourceParagraph": 2257
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Not as a story."
        }
      ],
      "sourceParagraph": 2258
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "But as something far more immediate."
        }
      ],
      "sourceParagraph": 2259
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Presence."
        }
      ],
      "sourceParagraph": 2260
    }
  ],
  "number": "CHAPTER 9-",
  "phase": "The Paradox of Explanation",
  "index": 20,
  "file": "chapters/20-chapter-09.json"
}
