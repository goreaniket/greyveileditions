  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum har cheez ko ek purpose ke lens se dekhte hain."
        }
      ],
      "sourceParagraph": 188
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har event ke peeche ek “reason” dhundte hain."
        }
      ],
      "sourceParagraph": 189
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har pain ke peeche ek “lesson” assign karte hain."
        }
      ],
      "sourceParagraph": 190
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur har loss ke peeche ek “hidden meaning” create kar lete hain."
        }
      ],
      "sourceParagraph": 191
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar direct experience ko dekha jaye…"
        }
      ],
      "sourceParagraph": 192
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh cheezein sirf ho rahi hoti hain."
        }
      ],
      "sourceParagraph": 193
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without explanation."
        }
      ],
      "sourceParagraph": 194
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without justification."
        }
      ],
      "sourceParagraph": 195
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without narrative intent."
        }
      ],
      "sourceParagraph": 196
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Purpose baad mein attach hota hai."
        }
      ],
      "sourceParagraph": 197
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind ke through."
        }
      ],
      "sourceParagraph": 198
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek situation hoti hai…"
        }
      ],
      "sourceParagraph": 199
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur turant mind usko frame karta hai:"
        }
      ],
      "sourceParagraph": 200
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye kyu hua"
        }
      ],
      "sourceParagraph": 201
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "isse kya seekhna hai"
        }
      ],
      "sourceParagraph": 202
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "iska deeper meaning kya hai"
        }
      ],
      "sourceParagraph": 203
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin situation khud kabhi ye questions carry nahi karti."
        }
      ],
      "sourceParagraph": 204
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo neutral hoti hai."
        }
      ],
      "sourceParagraph": 205
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Raw hoti hai."
        }
      ],
      "sourceParagraph": 206
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Uninterpreted hoti hai."
        }
      ],
      "sourceParagraph": 207
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Purpose ek story layer hai jo chaos ko structure deta hai."
        }
      ],
      "sourceParagraph": 208
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur structured chaos humare liye bearable ho jata hai."
        }
      ],
      "sourceParagraph": 209
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye mind quickly ek assumption create karta hai:"
        }
      ],
      "sourceParagraph": 210
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Har cheez kisi reason se ho rahi hai.”"
        }
      ],
      "sourceParagraph": 211
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin ye assumption kabhi verify nahi hota."
        }
      ],
      "sourceParagraph": 212
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf comfort generate karta hai."
        }
      ],
      "sourceParagraph": 213
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar kisi moment ko bina meaning ke dekha jaye…"
        }
      ],
      "sourceParagraph": 214
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo uncomfortable lag sakta hai."
        }
      ],
      "sourceParagraph": 215
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki mind ko anchor chahiye hota hai."
        }
      ],
      "sourceParagraph": 216
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur meaning wahi anchor ban jata hai."
        }
      ],
      "sourceParagraph": 217
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin truth ye hai:"
        }
      ],
      "sourceParagraph": 218
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience ko meaning ki zarurat nahi hoti."
        }
      ],
      "sourceParagraph": 219
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf mind ko hoti hai."
        }
      ],
      "sourceParagraph": 220
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Purpose ka illusion yahan se start hota hai:"
        }
      ],
      "sourceParagraph": 221
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jab mind randomness ko accept nahi kar pata."
        }
      ],
      "sourceParagraph": 222
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur randomness ko accept na karne ka solution hai:"
        }
      ],
      "sourceParagraph": 223
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“hidden design” imagine karna."
        }
      ],
      "sourceParagraph": 224
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye har cheez ek “lesson” ban jati hai."
        }
      ],
      "sourceParagraph": 225
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har pain ek “growth opportunity” ban jata hai."
        }
      ],
      "sourceParagraph": 226
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har loss ek “path correction” ban jata hai."
        }
      ],
      "sourceParagraph": 227
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin reality mein…"
        }
      ],
      "sourceParagraph": 228
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "cheezein na lesson hoti hain…"
        }
      ],
      "sourceParagraph": 229
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na punishment…"
        }
      ],
      "sourceParagraph": 230
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na reward."
        }
      ],
      "sourceParagraph": 231
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf events hote hain."
        }
      ],
      "sourceParagraph": 232
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye clearly dikhta hai…"
        }
      ],
      "sourceParagraph": 233
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange shift aata hai:"
        }
      ],
      "sourceParagraph": 234
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "meaning collapse nahi hota…"
        }
      ],
      "sourceParagraph": 235
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "bas unnecessary lagne lagta hai."
        }
      ],
      "sourceParagraph": 236
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab meaning unnecessary lagta hai…"
        }
      ],
      "sourceParagraph": 237
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek silence bachta hai:"
        }
      ],
      "sourceParagraph": 238
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo explanation se pehle bhi tha…"
        }
      ],
      "sourceParagraph": 239
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur explanation ke baad bhi hai."
        }
      ],
      "sourceParagraph": 240
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us silence mein koi question nahi hota."
        }
      ],
      "sourceParagraph": 241
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki “why” ki urgency hi dissolve ho chuki hoti hai."
        }
      ],
      "sourceParagraph": 242
    }
  ],
