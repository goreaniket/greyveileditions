      "sourceParagraph": 652
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab compulsion weak hoti hai…"
        }
      ],
      "sourceParagraph": 653
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh experience pehli baar bina filter ke appear hota hai."
        }
      ],
      "sourceParagraph": 654
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na usko defend karne ki zarurat."
        }
      ],
      "sourceParagraph": 655
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na usko reject karne ki zarurat."
        }
      ],
      "sourceParagraph": 656
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf ye recognition:"
        }
      ],
      "sourceParagraph": 657
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo bhi ho raha hai… wo already ho raha hai."
        }
      ],
      "sourceParagraph": 658
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye koi mystical state nahi hai."
        }
      ],
      "sourceParagraph": 659
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na enlightenment."
        }
      ],
      "sourceParagraph": 660
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na achievement."
        }
