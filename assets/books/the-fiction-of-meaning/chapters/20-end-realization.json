      "sourceParagraph": 669
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kuch naya nahi milta."
        }
      ],
      "sourceParagraph": 670
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf ek cheez absent hoti hai:"
