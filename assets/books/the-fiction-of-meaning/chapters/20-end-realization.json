      "sourceParagraph": 661
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ek simple clarity hai:"
        }
      ],
      "sourceParagraph": 662
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki reality ko explain karne ki zarurat kabhi thi hi nahi…"
