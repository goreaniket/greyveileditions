      "sourceParagraph": 671
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“explanation ki necessity”."
        }
      ],
      "sourceParagraph": 672
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab necessity nahi hoti…"
        }
      ],
      "sourceParagraph": 673
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh experience apne aap sufficient ho jata hai."
