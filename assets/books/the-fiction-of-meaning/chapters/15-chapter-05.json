      "sourceParagraph": 496
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange gap appear hota hai:"
        }
      ],
      "sourceParagraph": 497
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo cheezein “meaningful story” lagti thi…"
