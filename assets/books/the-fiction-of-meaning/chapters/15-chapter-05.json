    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hume direct experience se door bhi le jata hai."
        }
      ],
      "sourceParagraph": 495
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab ye clear hota hai…"
        }
