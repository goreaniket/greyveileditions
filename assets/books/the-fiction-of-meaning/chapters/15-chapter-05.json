  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum jo bhi experience karte hain…"
        }
      ],
      "sourceParagraph": 441
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo raw nahi rehta."
        }
      ],
      "sourceParagraph": 442
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo turant ek story ban jata hai."
        }
      ],
      "sourceParagraph": 443
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind ka sabse automatic function ye hai:"
        }
      ],
      "sourceParagraph": 444
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience ko narrative mein convert karna"
        }
      ],
      "sourceParagraph": 445
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek moment hota hai…"
        }
      ],
      "sourceParagraph": 446
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur us moment ke saath ek frame attach ho jata hai:"
        }
      ],
      "sourceParagraph": 447
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye kya hua"
        }
      ],
      "sourceParagraph": 448
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye kyu hua"
        }
      ],
      "sourceParagraph": 449
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "iska matlab kya hai"
        }
      ],
      "sourceParagraph": 450
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur aage kya hoga"
        }
      ],
      "sourceParagraph": 451
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin moment khud kabhi ye questions nahi laata."
        }
      ],
      "sourceParagraph": 452
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo sirf present hota hai."
        }
      ],
      "sourceParagraph": 453
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Story baad mein create hoti hai."
        }
      ],
      "sourceParagraph": 454
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur itni fast create hoti hai…"
        }
      ],
      "sourceParagraph": 455
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki lagta hai wo pehle se exist kar rahi thi."
        }
      ],
      "sourceParagraph": 456
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe illusion strong hota hai:"
        }
      ],
      "sourceParagraph": 457
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum experience ko live nahi karte…"
        }
      ],
      "sourceParagraph": 458
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hum experience ko narrate karte rehte hain."
        }
      ],
      "sourceParagraph": 459
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Mind har cheez ko sequence mein convert karta hai:"
        }
      ],
      "sourceParagraph": 460
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "beginning → middle → end"
        }
      ],
      "sourceParagraph": 461
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin reality mein aksar koi clear beginning ya end nahi hota."
        }
      ],
      "sourceParagraph": 462
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Sirf unfolding hota hai."
        }
      ],
      "sourceParagraph": 463
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Story ka structure hamesha meaning add karta hai."
        }
      ],
      "sourceParagraph": 464
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki bina meaning ke story stable nahi reh sakti."
        }
      ],
      "sourceParagraph": 465
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye mind randomness ko tolerate nahi karta."
        }
      ],
      "sourceParagraph": 466
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo har cheez ko connect karta hai."
        }
      ],
      "sourceParagraph": 467
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar kuch unclear hota hai…"
        }
      ],
      "sourceParagraph": 468
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh mind usko “setup” bana deta hai."
        }
      ],
      "sourceParagraph": 469
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar kuch painful hota hai…"
        }
      ],
      "sourceParagraph": 470
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh usko “lesson” bana deta hai."
        }
      ],
      "sourceParagraph": 471
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Agar kuch unexpected hota hai…"
        }
      ],
      "sourceParagraph": 472
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh usko “turning point” bana deta hai."
        }
      ],
      "sourceParagraph": 473
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi tarah life ek screenplay ban jati hai."
        }
      ],
      "sourceParagraph": 474
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin problem ye hai:"
        }
      ],
      "sourceParagraph": 475
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "screenplay reality nahi hoti."
        }
      ],
      "sourceParagraph": 476
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo editing hoti hai."
        }
      ],
      "sourceParagraph": 477
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur editing ke through hum reality ko readable bana lete hain."
        }
      ],
      "sourceParagraph": 478
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin readable hona ≠ true hona."
        }
      ],
      "sourceParagraph": 479
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Story ka sabse powerful effect ye hai:"
        }
      ],
      "sourceParagraph": 480
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo experience ko stable identity mein convert kar deta hai."
        }
      ],
      "sourceParagraph": 481
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur fir hum apne aap ko ek character ki tarah dekhne lagte hain:"
        }
      ],
      "sourceParagraph": 482
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "main yeh hoon"
        }
