      ],
      "sourceParagraph": 616
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without justification."
        }
      ],
      "sourceParagraph": 617
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without symbolic weight."
        }
      ],
      "sourceParagraph": 618
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yahin pe ek final realization quietly emerge hota hai:"
        }
