      "runs": [
        {
          "text": "sirf interpretation ne usko complex bana diya tha."
        }
      ],
      "sourceParagraph": 621
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab interpretation ka pressure hat jata hai…"
        }
      ],
      "sourceParagraph": 622
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh cheezein waise hi reh jati hain jaise wo pehle se thi:"
