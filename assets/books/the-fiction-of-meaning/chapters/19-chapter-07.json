    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jo bachta hai…"
        }
      ],
      "sourceParagraph": 627
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo silence nahi hota as an object…"
