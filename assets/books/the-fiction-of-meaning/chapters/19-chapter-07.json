      "sourceParagraph": 605
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Pure occurrence."
        }
      ],
      "sourceParagraph": 606
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur is simplicity ko mind initially resist karta hai."
        }
      ],
      "sourceParagraph": 607
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki mind ka kaam hi meaning banana hai."
