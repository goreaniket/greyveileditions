  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Har meaning system stable lagta hai…"
        }
      ],
      "sourceParagraph": 512
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jab tak usko question nahi kiya jata."
        }
      ],
      "sourceParagraph": 513
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Hum apni life ko multiple meaning layers ke through live karte hain:"
        }
      ],
      "sourceParagraph": 514
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye good hai ya bad hai"
        }
      ],
      "sourceParagraph": 515
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye success hai ya failure hai"
        }
      ],
      "sourceParagraph": 516
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye right hai ya wrong hai"
        }
      ],
      "sourceParagraph": 517
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ye loss hai ya lesson hai"
        }
      ],
      "sourceParagraph": 518
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur ye categories hume reality ko organize karne mein help karti hain."
        }
      ],
      "sourceParagraph": 519
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar in sab ko closely dekha jaye…"
        }
      ],
      "sourceParagraph": 520
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ye sab fixed reality nahi hoti."
        }
      ],
      "sourceParagraph": 521
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye shifting interpretations hoti hain."
        }
      ],
      "sourceParagraph": 522
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek hi event…"
        }
      ],
      "sourceParagraph": 523
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "alag states mein completely different meaning le leta hai."
        }
      ],
      "sourceParagraph": 524
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Iska matlab:"
        }
      ],
      "sourceParagraph": 525
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "meaning system stable nahi hai."
        }
      ],
      "sourceParagraph": 526
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo context dependent hai."
        }
      ],
      "sourceParagraph": 527
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin mind usko stable maan leta hai."
        }
      ],
      "sourceParagraph": 528
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki stability ek psychological need hai."
        }
      ],
      "sourceParagraph": 529
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab kisi system ko stable maan liya jata hai…"
        }
      ],
      "sourceParagraph": 530
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh usko defend bhi kiya jata hai."
        }
      ],
      "sourceParagraph": 531
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye beliefs, opinions, ideologies…"
        }
      ],
      "sourceParagraph": 532
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf thoughts nahi hote."
        }
      ],
      "sourceParagraph": 533
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo identity structures ban jate hain."
        }
      ],
      "sourceParagraph": 534
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab identity involved ho jati hai…"
        }
      ],
      "sourceParagraph": 535
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh meaning emotional ho jata hai."
        }
      ],
      "sourceParagraph": 536
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur emotional meaning…"
        }
      ],
      "sourceParagraph": 537
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "neutral observation ko replace kar deta hai."
        }
      ],
      "sourceParagraph": 538
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye hum reality ko dekhte kam hain…"
        }
      ],
      "sourceParagraph": 539
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "interpret zyada karte hain."
        }
      ],
      "sourceParagraph": 540
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin jab observation deep hota hai…"
        }
      ],
      "sourceParagraph": 541
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange instability visible hoti hai:"
        }
      ],
      "sourceParagraph": 542
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jo cheez “truth” lagti thi…"
        }
      ],
      "sourceParagraph": 543
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "wo sirf perspective lagne lagti hai."
        }
      ],
      "sourceParagraph": 544
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur perspective infinite hote hain."
        }
      ],
      "sourceParagraph": 545
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Isliye final truth hold nahi hota."
        }
      ],
      "sourceParagraph": 546
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Meaning systems collapse ka matlab ye nahi hota ki kuch toot jata hai physically."
        }
      ],
      "sourceParagraph": 547
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Matlab hota hai:"
        }
      ],
      "sourceParagraph": 548
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "certainty dissolve ho jati hai."
        }
      ],
      "sourceParagraph": 549
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab certainty dissolve hoti hai…"
        }
      ],
      "sourceParagraph": 550
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek uncomfortable openness bachi rehti hai."
        }
      ],
      "sourceParagraph": 551
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jahan kuch bhi fixed nahi hota."
        }
      ],
      "sourceParagraph": 552
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na label."
        }
      ],
      "sourceParagraph": 553
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na conclusion."
        }
      ],
      "sourceParagraph": 554
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na final answer."
        }
      ],
      "sourceParagraph": 555
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur yeh state initially unsettling lag sakti hai…"
        }
      ],
      "sourceParagraph": 556
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kyuki mind closure dhoondhta hai."
        }
      ],
      "sourceParagraph": 557
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin closure available nahi hota."
        }
      ],
      "sourceParagraph": 558
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab closure nahi milta…"
        }
      ],
      "sourceParagraph": 559
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh search weak ho jati hai."
        }
      ],
      "sourceParagraph": 560
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur search weak hone ke saath…"
        }
      ],
      "sourceParagraph": 561
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ek quiet clarity emerge hoti hai:"
        }
      ],
      "sourceParagraph": 562
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "cheezein explain nahi ho rahi hoti…"
        }
      ],
      "sourceParagraph": 563
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf unfold ho rahi hoti hain."
        }
      ],
      "sourceParagraph": 564
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur jab meaning systems collapse hote hain…"
        }
      ],
      "sourceParagraph": 565
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh reality khatam nahi hoti…"
        }
      ],
      "sourceParagraph": 566
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf interpretation ka weight kam ho jata hai."
        }
      ],
      "sourceParagraph": 567
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur us reduced weight ke saath…"
        }
      ],
      "sourceParagraph": 568
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "experience thoda zyada direct lagne lagta hai."
        }
      ],
      "sourceParagraph": 569
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without forcing meaning."
        }
      ],
      "sourceParagraph": 570
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Without demanding explanation."
        }
