      "sourceParagraph": 160
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kyuki jab meaning ka source clearly dikh jata hai…"
        }
      ],
      "sourceParagraph": 161
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh wo apni authority lose karne lagta hai."
        }
