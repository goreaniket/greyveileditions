      "sourceParagraph": 165
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh jo bachta hai wo confusion nahi hota."
        }
      ],
      "sourceParagraph": 166
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo hota hai directness."
        }
      ],
      "sourceParagraph": 167
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Raw presence."
        }
      ],
      "sourceParagraph": 168
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Unfiltered reality."
        }
      ],
      "sourceParagraph": 169
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye book tumhe koi new belief dene ke liye nahi hai."
        }
      ],
      "sourceParagraph": 170
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye sirf ye dikhane ke liye hai:"
        }
