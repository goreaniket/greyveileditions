  "elements": [
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek moment har insaan ki life mein aata hai…"
        }
      ],
      "sourceParagraph": 116
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "jab sirf experience kaafi nahi lagta."
        }
      ],
      "sourceParagraph": 117
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Kuch andar se push karta hai:"
        }
      ],
      "sourceParagraph": 118
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "“Iska matlab kya hai?”"
        }
      ],
      "sourceParagraph": 119
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur isi ek question ke saath…"
        }
      ],
      "sourceParagraph": 120
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "reality ka ek second layer create ho jata hai."
        }
      ],
      "sourceParagraph": 121
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na actual world…"
        }
      ],
      "sourceParagraph": 122
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but world ka interpretation."
        }
      ],
      "sourceParagraph": 123
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "The Human Fiction — Book II yahin se start hoti hai:"
        }
      ],
      "sourceParagraph": 124
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "na ki meaning already present hai…"
        }
      ],
      "sourceParagraph": 125
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "balke is urge se ki meaning create karna zaroori lagta hai."
        }
      ],
      "sourceParagraph": 126
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Meaning se pehle sirf occurrence hota hai."
        }
      ],
      "sourceParagraph": 127
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek thought aata hai."
        }
      ],
      "sourceParagraph": 128
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek feeling pass hoti hai."
        }
      ],
      "sourceParagraph": 129
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek event unfold hota hai."
        }
      ],
      "sourceParagraph": 130
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ek silence hota hai."
        }
      ],
      "sourceParagraph": 131
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin almost instantly…"
        }
      ],
      "sourceParagraph": 132
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "mind kuch bhi raw nahi rehne deta."
        }
      ],
      "sourceParagraph": 133
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Wo translate karta hai."
        }
      ],
      "sourceParagraph": 134
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Label deta hai."
        }
      ],
      "sourceParagraph": 135
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Explain karta hai."
        }
      ],
      "sourceParagraph": 136
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Conclusion bana deta hai."
        }
      ],
      "sourceParagraph": 137
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur is instant translation mein…"
        }
      ],
      "sourceParagraph": 138
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "raw experience ek structured reality ban jata hai."
        }
      ],
      "sourceParagraph": 139
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye book ye nahi kehti ki meaning galat hai."
        }
      ],
      "sourceParagraph": 140
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Ye ek deeper cheez dikhati hai:"
        }
      ],
      "sourceParagraph": 141
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "ki meaning milta nahi…"
        }
      ],
      "sourceParagraph": 142
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "banaya jata hai."
        }
      ],
      "sourceParagraph": 143
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Continuously."
        }
      ],
      "sourceParagraph": 144
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Unconsciously."
        }
      ],
      "sourceParagraph": 145
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Automatically."
        }
      ],
      "sourceParagraph": 146
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Aur kyuki ye process itni fast hoti hai…"
        }
      ],
      "sourceParagraph": 147
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "hume lagta hai ki meaning pehle se exist karta hai."
        }
      ],
      "sourceParagraph": 148
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Jaise reality already meaningful ho."
        }
      ],
      "sourceParagraph": 149
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Lekin agar thoda aur clearly dekha jaye…"
        }
      ],
      "sourceParagraph": 150
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "toh ek strange possibility dikhti hai:"
        }
      ],
      "sourceParagraph": 151
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "shayad reality meaningful nahi hai…"
        }
      ],
      "sourceParagraph": 152
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "sirf mind usko meaningful bana raha hai."
        }
      ],
      "sourceParagraph": 153
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Book II isi invisible habit ko explore karti hai:"
        }
      ],
      "sourceParagraph": 154
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "kaise hum experience ko story bana dete hain,"
        }
      ],
      "sourceParagraph": 155
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "events ko lesson bana dete hain,"
        }
      ],
      "sourceParagraph": 156
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "randomness ko design bana dete hain,"
        }
      ],
      "sourceParagraph": 157
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "aur silence ko message bana dete hain."
        }
      ],
      "sourceParagraph": 158
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Na ki meaning ko destroy karne ke liye…"
        }
      ],
      "sourceParagraph": 159
    },
    {
      "type": "paragraph",
      "runs": [
        {
          "text": "but uske origin ko clearly dekhne ke liye."
        }
