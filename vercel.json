{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "greyveileditions.vercel.app"
        }
      ],
      "destination": "https://greyveileditions.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.greyveileditions.site"
        }
      ],
      "destination": "https://greyveileditions.site/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/projects/:series/books/:book/reader/",
      "destination": "/reader/index.html"
    },
    {
      "source": "/projects/:series/books/:book/reader/:path*",
      "destination": "/reader/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/images/greyveil-logo.png",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
